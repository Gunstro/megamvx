      VALUES ($1, $2, TRUE)
      ON CONFLICT (business_id, block_number) 
      DO UPDATE SET is_active = TRUE, purchased_at = NOW()
      RETURNING *;
    `;
    const values = [id, blockNumber];
    const result = await db.query(query, values);

