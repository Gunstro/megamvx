        data: { linked_entities: linkedEntities }
      })
    }

    // Auto-suggest relevant hashtags
    const suggestedHashtags = await this.suggestHashtags(postData.content, linkedEntities)
    if (suggestedHashtags.length > 0) {
      await db.professional_posts.update({
        where: { id: post.id },
        data: { 
          hashtags: [...(postData.hashtags || []), ...suggestedHashtags] 
        }
      })
    }

    return post
  },

  async extractMVXEntities(content: string) {
    const entities = {
      territories: [] as string[],
      businesses: [] as string[],
      routes: [] as string[]
    }

    // Extract territory mentions
    const territoryMentions = content.match(/#Territory\[([^\]]+)\]/g)
    if (territoryMentions) {
      for (const mention of territoryMentions) {
        const territoryName = mention.match(/#Territory\[([^\]]+)\]/)?.[1]
        if (territoryName) {
          const territory = await db.territories.findFirst({
            where: { name: { contains: territoryName } }
          })
          if (territory) entities.territories.push(territory.id)
        }
      }
    }

    // Extract business mentions
    const businessMentions = content.match(/@([a-zA-Z0-9_-]+)/g)
    if (businessMentions) {
      for (const mention of businessMentions) {
        const businessName = mention.substring(1)
        const business = await db.business_listings.findFirst({
          where: { 
            OR: [
              { business_name: { contains: businessName } },
              { subdomain: businessName }
            ]
          }
        })
        if (business) entities.businesses.push(business.id)
      }
    }

    // Extract route mentions
    const routeMentions = content.match(/#Route\[([^\]]+)\]/g)
    if (routeMentions) {
      for (const mention of routeMentions) {
        const routeName = mention.match(/#Route\[([^\]]+)\]/)?.[1]
        if (routeName) {
          const route = await db.megamall_routes.findFirst({
            where: { name: { contains: routeName } }
          })
          if (route) entities.routes.push(route.id)
        }
      }
    }

    return entities
  },

  async suggestHashtags(content: string, linkedEntities: any) {
    const hashtags = new Set<string>()

    // Industry-specific hashtags based on content analysis
    const industryKeywords = {
      'blockchain': ['Web3', 'Blockchain', 'Crypto', 'DeFi'],
      'gaming': ['Gaming', 'eSports', 'VRGaming'],
      'ecommerce': ['eCommerce', 'RetailTech', 'DigitalCommerce'],
      'social': ['SocialMedia', 'Community', 'Networking']
    }

    // Add MVX ecosystem hashtags
    hashtags.add('MVX')
    hashtags.add('MegatonCities')
    
    if (linkedEntities.territories.length > 0) hashtags.add('TerritoryOwner')
    if (linkedEntities.businesses.length > 0) hashtags.add('BusinessOwner')
    if (linkedEntities.routes.length > 0) hashtags.add('RouteExplorer')

    // Add industry tags based on content
    const contentLower = content.toLowerCase()
    Object.entries(industryKeywords).forEach(([industry, tags]) => {
      if (tags.some(tag => contentLower.includes(tag.toLowerCase()))) {
        hashtags.add(industry)
      }
    })

    return Array.from(hashtags)
  },

  async endorseSkill(userId: string, targetUserId: string, skillName: string, weight: number = 1) {
    const endorsement = await db.skill_endorsements.upsert({
      where: {
        user_id_skill_name_endorser_id: {
          user_id: targetUserId,
          skill_name: skillName,
          endorser_id: userId
        }
      },
      update: { endorsement_weight: weight },
      create: {
        user_id: targetUserId,
        skill_name: skillName,
        endorser_id: userId,
        endorsement_weight: weight
      }
    })

    // Update skill endorsements count
    await this.updateSkillEndorsementCount(targetUserId, skillName)

    return endorsement
  },

  async writeRecommendation(userId: string, targetUserId: string, recommendationData: any) {
    const recommendation = await db.professional_recommendations.create({
      data: {
        user_id: targetUserId,
        recommender_id: userId,
        ...recommendationData
      }
    })

    // Update recommendations count
    await db.professional_profiles.update({
      where: { user_id: targetUserId },
      data: { recommendations_count: { increment: 1 } }
    })

    return recommendation
  }
}
