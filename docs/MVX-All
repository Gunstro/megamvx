export const userProfileService = {
  async getCompleteUserProfile(userId: string) {
    const [
      profile,
      visa,
      achievements,
      stats,
      territories,
      businesses,
      megamallAssets,
      activeRoutes
    ] = await Promise.all([
      db.user_profiles.findFirst({ where: { user_id: userId } }),
      db.user_visas.findFirst({ 
        where: { user_id: userId, is_active: true },
        orderBy: { issued_at: 'desc' }
      }),
      db.user_achievements.findMany({ 
        where: { user_id: userId },
        orderBy: { unlocked_at: 'desc' },
        take: 10
      }),
      db.user_stats.findFirst({ where: { user_id: userId } }),
      territoryService.getUserTerritories(userId),
      businessService.getUserBusinesses(userId),
      db.user_megamall_assets.findMany({ 
        where: { user_id: userId, is_active: true }
      }),
      db.user_routes.findMany({ 
        where: { user_id: userId },
        include: { route: true }
      })
    ])

    return {
      profile: profile || await this.createDefaultProfile(userId),
      visa: visa || await this.assignStarterVisa(userId),
      achievements,
      stats: stats || await this.createDefaultStats(userId),
      territories,
      businesses,
      megamallAssets,
      activeRoutes,
      matrixStats: await matrixService.getUserMatrixStats(userId)
    }
  },

  async createDefaultProfile(userId: string) {
    const user = await db.users.findFirst({ where: { id: userId } })
    return await db.user_profiles.create({
      data: {
        user_id: userId,
        display_name: user?.username || `User${userId.substring(0, 8)}`,
        bio: 'Exploring the MegatonCities MVX ecosystem',
        privacy_settings: {
          profile_public: true,
          show_businesses: true,
          show_achievements: true,
          show_network: true
        }
      }
