// lib/precision-math-service.ts

export class PrecisionMath {
  private static readonly MAX_PRECISION = 36;
  private static readonly INTERMEDIATE_PRECISION = 18;

  // Convert decimal to integer representation
  static toBaseUnits(amount: number | string, precision: number): bigint {
    const amountStr = typeof amount === 'number' ? amount.toFixed(precision) : amount;
    const [integerPart, fractionalPart = ''] = amountStr.split('.');
    const paddedFractional = fractionalPart.padEnd(precision, '0').substring(0, precision);
    return BigInt(integerPart + paddedFractional);
  }

  // Convert integer back to decimal
  static fromBaseUnits(amountBaseUnits: bigint, precision: number): string {
    const amountStr = amountBaseUnits.toString().padStart(precision + 1, '0');
    const integerPart = amountStr.slice(0, -precision) || '0';
    const fractionalPart = amountStr.slice(-precision);
    return `${integerPart}.${fractionalPart}`;
  }

  // Percentage calculation with precise rounding
  static calculatePercentage(
    amountBaseUnits: bigint,
    percentageBps: number, // basis points (1% = 100)
    precision: number,
    roundingMode: 'HALF_EVEN' | 'HALF_UP' | 'FLOOR' | 'CEILING' = 'HALF_EVEN'
  ): bigint {
    // Convert percentage to intermediate precision (avoid floating point)
    const percentageBigInt = BigInt(percentageBps);
    const bpsBase = 10000n; // 100.00% = 10000 basis points
    
    // Calculate: (amount * percentage) / 10000
    const intermediateResult = (amountBaseUnits * percentageBigInt) / bpsBase;
    
    // Handle remainder for precise rounding
    const remainder = (amountBaseUnits * percentageBigInt) % bpsBase;
    
    return this.applyRounding(intermediateResult, remainder, bpsBase, roundingMode);
  }

  private static applyRounding(
    value: bigint,
    remainder: bigint,
    divisor: bigint,
    roundingMode: string
  ): bigint {
    const halfDivisor = divisor / 2n;
    
    switch (roundingMode) {
      case 'HALF_EVEN': // Bankers rounding
        if (remainder > halfDivisor) {
          return value + 1n;
        } else if (remainder === halfDivisor) {
          // Round to nearest even number
          return value % 2n === 0n ? value : value + 1n;
        }
        return value;
        
      case 'HALF_UP': // Common rounding
        return remainder >= halfDivisor ? value + 1n : value;
        
      case 'FLOOR': // Always round down
        return value;
        
      case 'CEILING': // Always round up
        return remainder > 0n ? value + 1n : value;
        
      default:
        return value;
    }
  }

  // Distributed amount calculation (avoid remainder accumulation)
  static distributeAmount(
    totalAmountBaseUnits: bigint,
    ratios: number[], // Array of ratios that should sum to 1
    precision: number,
    roundingMode: string = 'HALF_EVEN'
  ): bigint[] {
    const distributed: bigint[] = [];
    let distributedTotal = 0n;
    
    // Calculate each portion
    for (let i = 0; i < ratios.length; i++) {
      const ratioBps = Math.round(ratios[i] * 10000); // Convert to basis points
      const portion = this.calculatePercentage(totalAmountBaseUnits, ratioBps, precision, roundingMode);
      distributed.push(portion);
      distributedTotal += portion;
    }
    
    // Handle rounding differences
    const difference = totalAmountBaseUnits - distributedTotal;
    if (difference !== 0n) {
      // Adjust the largest portion to account for rounding difference
      const largestIndex = this.findLargestPortionIndex(distributed);
      distributed[largestIndex] += difference;
    }
    
    return distributed;
  }

  private static findLargestPortionIndex(portions: bigint[]): number {
    let largestIndex = 0;
    let largestValue = portions[0];
    
    for (let i = 1; i < portions.length; i++) {
      if (portions[i] > largestValue) {
        largestValue = portions[i];
        largestIndex = i;
      }
    }
    
    return largestIndex;
  }
}
