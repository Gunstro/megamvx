  )
}

// MegaFrag Experience Component
function MegaFragExperience({ frag, accessibilityProfile, visitType }: any) {
  const [currentExperience, setCurrentExperience] = useState<any>(null)
  const [comfortSettings, setComfortSettings] = useState(accessibilityProfile?.comfort_limits || {})
  const [sessionTime, setSessionTime] = useState(0)

  useEffect(() => {
    startExperience()
    const timer = setInterval(() => {
      setSessionTime(prev => prev + 1)
    }, 1000)

    return () => clearInterval(timer)
  }, [])

  const startExperience = async () => {
    const experience = await megaFragsService.startMegaFragVisit(
      accessibilityProfile.user_id,
      frag.id,
      visitType,
      accessibilityProfile.id
    )
    setCurrentExperience(experience)
  }

  return (
    <div className="fixed inset-0 bg-black z-50">
      {/* Experience Header */}
      <div className="absolute top-0 left-0 right-0 bg-black/50 backdrop-blur-sm border-b border-slate-800 z-10">
        <div className="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-4">
          <div className="flex items-center justify-between">
            <div>
              <h1 className="text-xl font-bold text-white">{frag.name}</h1>
              <p className="text-slate-400 text-sm">
                {visitType.toUpperCase()} Experience • {Math.floor(sessionTime / 60)}m {sessionTime % 60}s
              </p>
            </div>
            
            {/* Comfort Controls */}
            <div className="flex items-center space-x-4">
              <ComfortControl 
                icon={<Volume2 className="h-4 w-4" />}
                label="Audio"
                value={comfortSettings.audioLevel || 50}
                onChange={(value) => setComfortSettings({...comfortSettings, audioLevel: value})}
              />
              <ComfortControl 
                icon={<Contrast className="h-4 w-4" />}
                label="Contrast"
                value={comfortSettings.contrast || 50}
                onChange={(value) => setComfortSettings({...comfortSettings, contrast: value})}
              />
              <ComfortControl 
                icon={<Navigation className="h-4 w-4" />}
                label="Motion"
                value={comfortSettings.motionLevel || 25}
                onChange={(value) => setComfortSettings({...comfortSettings, motionLevel: value})}
              />
              
              <button className="bg-red-600 hover:bg-red-700 text-white px-4 py-2 rounded-lg font-semibold">
                End Visit
              </button>
            </div>
          </div>
        </div>
      </div>

      {/* Main Experience Area */}
      <div className="pt-20 h-full">
        {visitType === 'vr' && (
          <VRExperience 
            frag={frag}
            comfortSettings={comfortSettings}
            accessibilityProfile={accessibilityProfile}
          />
        )}
        {visitType === 'ar' && (
          <ARExperience 
            frag={frag}
            comfortSettings={comfortSettings}
          />
        )}
        {visitType === 'desktop' && (
          <DesktopExperience 
            frag={frag}
            comfortSettings={comfortSettings}
            accessibilityProfile={accessibilityProfile}
          />
        )}
      </div>

      {/* Accessibility Assistant */}
      <div className="absolute bottom-4 left-4">
        <AccessibilityAssistant 
          frag={frag}
          comfortSettings={comfortSettings}
          sessionTime={sessionTime}
        />
      </div>
    </div>
  )
}

// Accessibility Assistant Component
function AccessibilityAssistant({ frag, comfortSettings, sessionTime }: any) {
  const [suggestions, setSuggestions] = useState<string[]>([])

  useEffect(() => {
    // Generate comfort suggestions based on session time and settings
    const newSuggestions = []
    
    if (sessionTime > 1800) { // 30 minutes
      newSuggestions.push('Consider taking a break soon')
    }
    
    if (comfortSettings.motionLevel > 70) {
      newSuggestions.push('High motion level detected - consider reducing for comfort')
    }
    
    if (comfortSettings.audioLevel > 80) {
      newSuggestions.push('Loud audio detected - consider lowering volume')
    }

    setSuggestions(newSuggestions)
  }, [sessionTime, comfortSettings])

  return (
    <div className="bg-slate-800/90 backdrop-blur-sm border border-slate-700 rounded-2xl p-4 max-w-sm">
      <h3 className="font-semibold text-white mb-2 flex items-center">
        <Brain className="h-4 w-4 mr-2 text-green-400" />
        Accessibility Assistant
      </h3>
      
      {suggestions.length > 0 ? (
        <div className="space-y-2">
          {suggestions.map((suggestion, index) => (
            <div key={index} className="text-yellow-400 text-sm flex items-start">
              <span className="mr-2">•</span>
              {suggestion}
            </div>
          ))}
        </div>
      ) : (
        <p className="text-green-400 text-sm">
          Your experience is optimized for comfort and accessibility
        </p>
      )}

      <div className="mt-3 pt-3 border-t border-slate-700">
        <div className="flex justify-between text-xs text-slate-400">
          <span>Session Duration:</span>
          <span>{Math.floor(sessionTime / 60)}m {sessionTime % 60}s</span>
        </div>
        <div className="flex justify-between text-xs text-slate-400">
          <span>Comfort Level:</span>
          <span className="text-green-400">Optimal</span>
        </div>
      </div>
    </div>
  )
}
