CREATE OR REPLACE FUNCTION check_earning_cap_and_upgrade(
  user_id UUID
) RETURNS TEXT AS $$
DECLARE
  user_record RECORD;
  current_tier RECORD;
  next_tier RECORD;
  upgrade_available BOOLEAN := false;
BEGIN
  -- Get user's current earnings and tier
  SELECT up.*, vt.earning_cap, vt.name as tier_name
  INTO user_record
  FROM user_profiles up
  JOIN visa_tiers vt ON up.current_visa_tier_id = vt.id
  WHERE up.id = user_id;

  -- Check if hit cap
  IF user_record.total_earnings >= user_record.earning_cap THEN
    -- Find next upgrade tier
    SELECT * INTO next_tier
    FROM visa_tiers 
    WHERE category = 'Standard' 
      AND upgrade_order > (SELECT upgrade_order FROM visa_tiers WHERE id = user_record.current_visa_tier_id)
    ORDER BY upgrade_order ASC
    LIMIT 1;

    IF next_tier.id IS NOT NULL THEN
      -- Auto-trigger upgrade or notify user
      RETURN 'UPGRADE_AVAILABLE: ' || next_tier.name;
    ELSE
      RETURN 'MAX_TIER_REACHED';
    END IF;
  END IF;

  RETURN 'BELOW_CAP';
END;
$$ LANGUAGE plpgsql;
