// lib/routes-vr-ar-service.ts
export const routesVrArService = {
  async startRouteVRSession(userId: string, routeId: string, deviceInfo: any = {}) {
    const route = await db.megamall_routes.findFirst({
      where: { id: routeId },
      include: { waypoints: true }
    })

    const session = await db.route_vr_sessions.create({
      data: {
