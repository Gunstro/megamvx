    available_units INTEGER NOT NULL,
    floor_level INTEGER DEFAULT 1,
    is_active BOOLEAN DEFAULT TRUE,
    created_at TIMESTAMPTZ DEFAULT NOW()
);

CREATE TABLE megamall_stores (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    zone_id UUID NOT NULL REFERENCES megamall_zones(id),
    user_id UUID NOT NULL REFERENCES users(id),
    business_id UUID REFERENCES business_listings(id),
    store_name VARCHAR(255) NOT NULL,
    store_description TEXT,
    store_category VARCHAR(100),
    store_theme JSONB NOT NULL DEFAULT '{}',
    vr_store_url VARCHAR(500),
    ar_experience_url VARCHAR(500),
    store_logo_url VARCHAR(500),
    cover_image_url VARCHAR(500),
    rent_price DECIMAL(15,2) NOT NULL,
    monthly_revenue DECIMAL(15,2) DEFAULT 0,
    visitor_count INTEGER DEFAULT 0,
    is_active BOOLEAN DEFAULT TRUE,
    is_featured BOOLEAN DEFAULT FALSE,
    opening_date TIMESTAMPTZ,
    created_at TIMESTAMPTZ DEFAULT NOW()
);

CREATE TABLE virtual_products (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    store_id UUID NOT NULL REFERENCES megamall_stores(id),
    product_name VARCHAR(255) NOT NULL,
    product_description TEXT,
    product_type VARCHAR(50) NOT NULL, -- 'physical', 'digital', 'virtual', 'nft'
    category VARCHAR(100) NOT NULL,
    price DECIMAL(15,2) NOT NULL,
    currency VARCHAR(10) DEFAULT 'MB',
    inventory_count INTEGER DEFAULT -1, -- -1 for unlimited
    product_images JSONB DEFAULT '[]',
    vr_product_url VARCHAR(500),
    ar_preview_url VARCHAR(500),
    nft_metadata JSONB,
    is_available BOOLEAN DEFAULT TRUE,
    tags TEXT[] DEFAULT '{}',
    created_at TIMESTAMPTZ DEFAULT NOW()
);

CREATE TABLE megamall_transactions (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    store_id UUID NOT NULL REFERENCES megamall_stores(id),
    product_id UUID REFERENCES virtual_products(id),
    buyer_id UUID NOT NULL REFERENCES users(id),
    transaction_type VARCHAR(50) NOT NULL, -- 'product_purchase', 'store_rental', 'service'
    amount DECIMAL(15,2) NOT NULL,
    currency VARCHAR(10) DEFAULT 'MB',
    hedera_transaction_id VARCHAR(100),
    vr_session_id VARCHAR(100),
    ar_session_id VARCHAR(100),
    status VARCHAR(50) DEFAULT 'completed',
    created_at TIMESTAMPTZ DEFAULT NOW()
);

-- AR/VR Experience Tracking
CREATE TABLE vr_sessions (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
