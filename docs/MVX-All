CREATE TABLE ward_commission_ledger (
  ledger_id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
  ward_id UUID REFERENCES geo_sovereignty_wards,
  ownership_id UUID REFERENCES ward_ownership,
  
  -- Commission Sources
