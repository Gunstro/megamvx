class SmartTriggerConditions {
  checkActivationConditions(cvbTrigger, userContext) {
    const conditions = cvbTrigger.required_conditions || {};
    
    let canActivate = true;

    // Time-based conditions
    if (conditions.time_window) {
      canActivate = canActivate && this.checkTimeWindow(conditions.time_window);
    }

    // Weather conditions
    if (conditions.weather) {
      canActivate = canActivate && this.checkWeatherConditions(conditions.weather);
    }

    // User history conditions
    if (conditions.user_requirements) {
      canActivate = canActivate && this.checkUserRequirements(
        conditions.user_requirements, 
        userContext
      );
    }

    // Location sequence conditions
    if (conditions.requires_previous_visit) {
      canActivate = canActivate && this.checkLocationSequence(userContext);
    }

    return canActivate;
  }

  checkTimeWindow(timeWindow) {
    const now = new Date();
    const currentTime = now.getHours() * 60 + now.getMinutes();
    
    return currentTime >= timeWindow.start && currentTime <= timeWindow.end;
  }

  checkWeatherConditions(weatherReq) {
    const currentWeather = this.getCurrentWeather();
    
    if (weatherReq.condition && currentWeather.condition !== weatherReq.condition) {
      return false;
    }
    
    if (weatherReq.temp_min && currentWeather.temperature < weatherReq.temp_min) {
      return false;
    }
    
    return true;
  }

  checkUserRequirements(requirements, userContext) {
    if (requirements.min_level && userContext.level < requirements.min_level) {
      return false;
    }
    
    if (requirements.required_badges) {
      const hasBadges = requirements.required_badges.every(
        badge => userContext.badges.includes(badge)
      );
      if (!hasBadges) return false;
    }
    
    return true;
  }
}
