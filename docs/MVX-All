// lib/megaprofile-service.ts
export const megaProfileService = {
  async createProfessionalProfile(userId: string, profileData: any) {
    const existingProfile = await db.professional_profiles.findFirst({
      where: { user_id: userId }
    })

    if (existingProfile) {
      return await db.professional_profiles.update({
        where: { id: existingProfile.id },
        data: profileData
      })
    }

    return await db.professional_profiles.create({
      data: {
        user_id: userId,
        professional_headline: profileData.professional_headline || 'MVX Ecosystem Professional',
        summary: profileData.summary || 'Building the future of commerce, community, and digital innovation',
        ...profileData
      }
    })
  },

  async getCompleteUserProfile(userId: string, viewerId?: string) {
    const [
      socialProfile,
      professionalProfile,
      mvxStats,
      recentPosts,
      recommendations,
      skills,
      mutualConnections
    ] = await Promise.all([
      db.social_profiles.findFirst({ 
        where: { user_id: userId },
        include: { user: true }
      }),
      db.professional_profiles.findFirst({ where: { user_id: userId } }),
      this.getMVXStats(userId),
      this.getProfessionalPosts(userId, 10),
      db.professional_recommendations.findMany({
        where: { user_id: userId, is_visible: true },
        include: { recommender: { include: { professional_profile: true } } }
      }),
      this.getUserSkillsWithEndorsements(userId),
      viewerId ? this.getMutualConnections(userId, viewerId) : []
    ])

    // Calculate profile completeness score
    const completenessScore = await this.calculateProfileCompleteness(userId)

    return {
      social: socialProfile,
      professional: professionalProfile,
      mvx: mvxStats,
      activity: {
        recentPosts,
        recommendations,
        skills
      },
      network: {
        mutualConnections,
        connectionStrength: viewerId ? await this.calculateConnectionStrength(userId, viewerId) : null
      },
      analytics: {
        completenessScore,
        lastUpdated: professionalProfile?.updated_at
      }
    }
  },

  async getMVXStats(userId: string) {
    const [
      territories,
      businesses,
      routes,
      commissions,
      network
    ] = await Promise.all([
      territoryService.getUserTerritories(userId),
      businessService.getUserBusinesses(userId),
      megaRoutesService.getUserRouteCompletions(userId),
      geographicWalletService.getUserTotalCommissions(userId),
      matrixService.getUserNetworkStats(userId)
    ])

    return {
      territories: {
        count: territories.length,
        totalValue: territories.reduce((sum, t) => sum + (t.purchase_price || 0), 0),
        monthlyRevenue: territories.reduce((sum, t) => sum + (t.statistics?.monthly_revenue || 0), 0)
      },
      businesses: {
        count: businesses.length,
        activeStores: businesses.filter(b => b.is_active).length,
        totalRevenue: businesses.reduce((sum, b) => sum + (b.monthly_revenue || 0), 0)
      },
      routes: {
        completed: routes.filter(r => r.status === 'completed').length,
        inProgress: routes.filter(r => r.status === 'active').length,
        totalXPEarned: routes.reduce((sum, r) => sum + (r.total_xp_earned || 0), 0)
      },
      economy: {
        totalCommissions: commissions,
        monthlyRecurring: await geographicWalletService.getUserMonthlyRevenue(userId),
        networkEarnings: network.matrixCommissions || 0
      },
      influence: {
        networkSize: network.teamSize || 0,
        socialImpact: await this.calculateSocialImpact(userId),
        ecosystemValue: await this.calculateEcosystemValue(userId)
      }
    }
  },

  async createProfessionalPost(userId: string, postData: any) {
    const post = await db.professional_posts.create({
      data: {
        user_id: userId,
        ...postData,
        is_thread_start: !postData.parent_post_id
      }
    })

    // Auto-detect and link MVX entities
    const linkedEntities = await this.extractMVXEntities(postData.content)
    if (Object.keys(linkedEntities).length > 0) {
      await db.professional_posts.update({
        where: { id: post.id },
        data: { linked_entities: linkedEntities }
      })
    }

    // Auto-suggest relevant hashtags
    const suggestedHashtags = await this.suggestHashtags(postData.content, linkedEntities)
    if (suggestedHashtags.length > 0) {
      await db.professional_posts.update({
        where: { id: post.id },
        data: { 
          hashtags: [...(postData.hashtags || []), ...suggestedHashtags] 
        }
      })
    }

    return post
  },

  async extractMVXEntities(content: string) {
    const entities = {
      territories: [] as string[],
      businesses: [] as string[],
      routes: [] as string[]
    }

    // Extract territory mentions
    const territoryMentions = content.match(/#Territory\[([^\]]+)\]/g)
    if (territoryMentions) {
      for (const mention of territoryMentions) {
        const territoryName = mention.match(/#Territory\[([^\]]+)\]/)?.[1]
        if (territoryName) {
          const territory = await db.territories.findFirst({
            where: { name: { contains: territoryName } }
          })
          if (territory) entities.territories.push(territory.id)
        }
      }
    }

    // Extract business mentions
    const businessMentions = content.match(/@([a-zA-Z0-9_-]+)/g)
    if (businessMentions) {
      for (const mention of businessMentions) {
        const businessName = mention.substring(1)
        const business = await db.business_listings.findFirst({
          where: { 
            OR: [
              { business_name: { contains: businessName } },
              { subdomain: businessName }
            ]
          }
        })
        if (business) entities.businesses.push(business.id)
      }
    }

    // Extract route mentions
    const routeMentions = content.match(/#Route\[([^\]]+)\]/g)
    if (routeMentions) {
      for (const mention of routeMentions) {
        const routeName = mention.match(/#Route\[([^\]]+)\]/)?.[1]
        if (routeName) {
          const route = await db.megamall_routes.findFirst({
            where: { name: { contains: routeName } }
          })
          if (route) entities.routes.push(route.id)
        }
      }
    }

    return entities
  },

  async suggestHashtags(content: string, linkedEntities: any) {
    const hashtags = new Set<string>()

    // Industry-specific hashtags based on content analysis
    const industryKeywords = {
      'blockchain': ['Web3', 'Blockchain', 'Crypto', 'DeFi'],
      'gaming': ['Gaming', 'eSports', 'VRGaming'],
      'ecommerce': ['eCommerce', 'RetailTech', 'DigitalCommerce'],
      'social': ['SocialMedia', 'Community', 'Networking']
    }

    // Add MVX ecosystem hashtags
    hashtags.add('MVX')
    hashtags.add('MegatonCities')
    
    if (linkedEntities.territories.length > 0) hashtags.add('TerritoryOwner')
    if (linkedEntities.businesses.length > 0) hashtags.add('BusinessOwner')
    if (linkedEntities.routes.length > 0) hashtags.add('RouteExplorer')

    // Add industry tags based on content
    const contentLower = content.toLowerCase()
    Object.entries(industryKeywords).forEach(([industry, tags]) => {
      if (tags.some(tag => contentLower.includes(tag.toLowerCase()))) {
        hashtags.add(industry)
      }
    })

    return Array.from(hashtags)
  },

  async endorseSkill(userId: string, targetUserId: string, skillName: string, weight: number = 1) {
    const endorsement = await db.skill_endorsements.upsert({
      where: {
        user_id_skill_name_endorser_id: {
          user_id: targetUserId,
          skill_name: skillName,
          endorser_id: userId
        }
      },
      update: { endorsement_weight: weight },
      create: {
        user_id: targetUserId,
        skill_name: skillName,
        endorser_id: userId,
        endorsement_weight: weight
      }
    })

    // Update skill endorsements count
    await this.updateSkillEndorsementCount(targetUserId, skillName)

    return endorsement
  },

  async writeRecommendation(userId: string, targetUserId: string, recommendationData: any) {
    const recommendation = await db.professional_recommendations.create({
      data: {
        user_id: targetUserId,
        recommender_id: userId,
        ...recommendationData
      }
    })

    // Update recommendations count
    await db.professional_profiles.update({
      where: { user_id: targetUserId },
      data: { recommendations_count: { increment: 1 } }
    })

    return recommendation
  }
}
