ADD COLUMN status TEXT DEFAULT 'available', -- 'available', 'pending', 'reversed'
ADD COLUMN available_after TIMESTAMPTZ, -- NULL = immediately available
ADD COLUMN reversed_at TIMESTAMPTZ;

-- Function to check available balance (excludes pending commissions)
CREATE OR REPLACE FUNCTION get_available_balance(user_id UUID)
RETURNS DECIMAL AS $$
DECLARE
  available DECIMAL;
BEGIN
  SELECT COALESCE(SUM(amount), 0) INTO available
  FROM commission_ledger 
  WHERE to_user_id = user_id 
    AND status = 'available'
    AND (available_after IS NULL OR available_after <= NOW());
    
  RETURN available;
END;
$$ LANGUAGE plpgsql;

-- Chargeback reversal function
CREATE OR REPLACE FUNCTION reverse_commission(
  visa_sale_id UUID,
  reason TEXT DEFAULT 'chargeback'
) RETURNS BOOLEAN AS $$
BEGIN
  -- Reverse the commission
  UPDATE commission_ledger 
  SET status = 'reversed',
      reversed_at = NOW()
  WHERE source_type = 'visa_sale' 
    AND from_user_id = (SELECT buyer_user_id FROM visa_sales WHERE id = visa_sale_id)
    AND status IN ('available', 'pending');
    
  -- Deduct from user's balance
  UPDATE user_profiles 
  SET current_balance = GREATEST(0, current_balance - (
    SELECT COALESCE(SUM(amount), 0) 
    FROM commission_ledger 
    WHERE status = 'reversed' 
      AND to_user_id = user_profiles.id
      AND reversed_at >= NOW() - INTERVAL '1 hour'
  ))
  WHERE id IN (
    SELECT to_user_id FROM commission_ledger 
    WHERE source_type = 'visa_sale' 
      AND from_user_id = (SELECT buyer_user_id FROM visa_sales WHERE id = visa_sale_id)
  );
  
  RETURN true;
END;
$$ LANGUAGE plpgsql;
