-- MegaFrags Core Tables
CREATE TABLE megafrags (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    frag_number VARCHAR(50) UNIQUE NOT NULL, -- Unique identifier like "MF-001"
    name VARCHAR(255) NOT NULL,
    description TEXT,
    
    -- Geographic Data
    geographic_location GEOGRAPHY(Point, 4326) NOT NULL,
    bounding_box GEOGRAPHY(Polygon, 4326),
    elevation_data JSONB, -- Topographic information
    climate_zone VARCHAR(100),
    biome_type VARCHAR(100),
    
    -- Ownership & Economics
    current_owner_id UUID REFERENCES users(id),
    original_price DECIMAL(15,2) NOT NULL,
    current_value DECIMAL(15,2) NOT NULL,
    purchase_date TIMESTAMPTZ,
    
    -- Immersive Experience Data
    vr_environment_url VARCHAR(500),
    ar_experience_url VARCHAR(500),
    photogrammetry_data JSONB, -- 3D scan data
    soundscape_data JSONB, -- Ambient sounds
    weather_simulation JSONB, -- Real-time weather replication
    
    -- Accessibility Features
    accessibility_features JSONB DEFAULT '{
        "wheelchair_accessible": true,
        "audio_descriptions": true,
        "haptic_feedback": true,
        "simplified_navigation": true,
        "contrast_options": true,
        "motion_reduction": true
    }',
    
    -- Experience Customization
    experience_intensity VARCHAR(20) DEFAULT 'moderate', -- gentle, moderate, intense
    motion_level VARCHAR(20) DEFAULT 'low', -- low, medium, high
    sensory_stimulation_level VARCHAR(20) DEFAULT 'balanced',
    
    -- Historical & Cultural Data
    historical_significance TEXT,
    cultural_importance TEXT,
    ecological_data JSONB,
    conservation_status VARCHAR(100),
    
    -- Social Features
    visitor_count INTEGER DEFAULT 0,
    average_visit_duration INTEGER DEFAULT 0, -- in minutes
    favorite_count INTEGER DEFAULT 0,
    
    -- Status
    is_public BOOLEAN DEFAULT FALSE, -- Can be visited by others
    is_featured BOOLEAN DEFAULT FALSE,
    status VARCHAR(50) DEFAULT 'active',
    
    created_at TIMESTAMPTZ DEFAULT NOW(),
    updated_at TIMESTAMPTZ DEFAULT NOW()
);

-- MegaFrag Experiences & Content
CREATE TABLE megafrag_experiences (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
