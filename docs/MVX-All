      include: { zone: true }
    })

    const vrEnvironment = {
      sessionId: session.id,
      store: {
        id: store.id,
        name: store.store_name,
        theme: store.store_theme,
        products: await db.virtual_products.findMany({
          where: { store_id: storeId, is_available: true }
        })
      },
      zone: {
        theme: store.zone.theme_settings,
        background: store.zone.vr_environment_url
      },
      user: {
        avatar: await this.getUserAvatar(userId),
        preferences: await this.getUserVRSettings(userId)
      }
    }

    return {
      sessionId: session.id,
      vrUrl: `${process.env.VR_BASE_URL}/experience/${session.id}`,
      environment: vrEnvironment
    }
  },

  async launchARExperience(productId: string, userId: string) {
    const product = await db.virtual_products.findFirst({
      where: { id: productId },
      include: { ar_experience: true }
    })

    if (!product.ar_experience) {
      throw new Error('AR experience not available for this product')
    }

    const arExperience = {
      product: {
        id: product.id,
        name: product.product_name,
        type: product.product_type,
        modelUrl: product.ar_experience.ar_model_url,
        markerUrl: product.ar_experience.marker_image_url
