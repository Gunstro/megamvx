// Social Feed Component
function SocialFeed({ currentUserId, socialGraph }: any) {
  const [feed, setFeed] = useState<any[]>([])
  const [isLoading, setIsLoading] = useState(true)

  useEffect(() => {
    loadFeed()
  }, [currentUserId])

  const loadFeed = async () => {
    setIsLoading(true)
    try {
      const feedData = await megaSocialService.getPersonalizedFeed(currentUserId, {
        limit: 20,
        contentTypes: ['all'],
        sources: ['connections', 'groups', 'territories']
      })
      setFeed(feedData.posts)
    } catch (error) {
      console.error('Failed to load feed:', error)
    } finally {
      setIsLoading(false)
    }
  }

  if (isLoading) {
    return <FeedSkeleton />
  }

  return (
    <div className="space-y-6">
      {feed.map((post) => (
        <SocialPost 
          key={post.id}
          post={post}
          currentUserId={currentUserId}
          onEngagement={loadFeed}
        />
      ))}
    </div>
  )
}

// Social Post Component
function SocialPost({ post, currentUserId, onEngagement }: any) {
  const [isLiked, setIsLiked] = useState(post.user_engagement?.liked || false)
  const [isTipping, setIsTipping] = useState(false)
  const [tipAmount, setTipAmount] = useState(5)

  const handleLike = async () => {
    try {
      if (isLiked) {
        await megaSocialService.unlikePost(currentUserId, post.id)
      } else {
        await megaSocialService.likePost(currentUserId, post.id)
      }
      setIsLiked(!isLiked)
      onEngagement?.()
    } catch (error) {
      console.error('Failed to toggle like:', error)
    }
  }

  const handleTip = async () => {
    try {
      await megaSocialService.tipUser(
        currentUserId,
        post.user_id,
        tipAmount,
        'Great post!',
        post.id
      )
      setIsTipping(false)
      onEngagement?.()
    } catch (error) {
      console.error('Failed to send tip:', error)
    }
  }

  const handleBoost = async (boostType: string) => {
    try {
      await megaSocialService.boostPost(currentUserId, post.id, boostType, 10)
      onEngagement?.()
