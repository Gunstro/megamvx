        route_id: routeId,
        session_type: 'full_immersion',
        device_info: deviceInfo
      }
    })

    const vrEnvironment = {
      sessionId: session.id,
      route: {
        id: route.id,
        name: route.name,
        type: route.route_type,
        theme: route.theme_settings,
        waypoints: route.waypoints.map((wp: any) => ({
          id: wp.id,
          number: wp.waypoint_number,
          name: wp.name,
          type: wp.type,
          vrExperience: wp.vr_experience,
          location: wp.location
        }))
      },
      user: {
        avatar: await this.getUserVRAvatar(userId),
        preferences: await this.getUserVRPreferences(userId)
      },
      social: {
        nearbyUsers: await this.getNearbyVRUsers(routeId),
        guideAvatars: await this.getRouteGuides(routeId)
      }
    }

    return {
      sessionId: session.id,
      vrUrl: `${process.env.VR_ROUTES_BASE_URL}/route/${routeId}/session/${session.id}`,
      environment: vrEnvironment
    }
  },

  async launchARWaypointExperience(waypointId: string, userId: string, userLocation: any) {
    const waypoint = await db.route_waypoints.findFirst({
      where: { id: waypointId },
      include: { route: true }
    })

    if (!waypoint.ar_experience) {
      throw new Error('AR experience not available for this waypoint')
    }

    // Start AR session
    const arSession = await db.route_ar_sessions.create({
      data: {
        user_id: userId,
        waypoint_id: waypointId,
        session_type: waypoint.ar_experience.interaction_type,
        device_info: { userLocation }
      }
    })

    const arExperience = {
      sessionId: arSession.id,
      waypoint: {
        id: waypoint.id,
        name: waypoint.name,
        description: waypoint.description,
        type: waypoint.type
      },
      experience: {
        markerUrl: waypoint.ar_experience.marker_url,
        modelUrl: waypoint.ar_experience.model_url,
        interactionType: waypoint.ar_experience.interaction_type,
        triggers: waypoint.ar_experience.triggers,
        mediaContent: waypoint.media_content
      },
      route: {
        name: waypoint.route.name,
        currentWaypoint: waypoint.waypoint_number
      }
    }

    return {
      sessionId: arSession.id,
      arLaunchUrl: `megatoncities-routes-ar://waypoint/${waypointId}/session/${arSession.id}`,
      webArUrl: `${process.env.AR_ROUTES_WEB_URL}/waypoint/${waypointId}`,
      experience: arExperience
    }
  },

  async handleARWaypointCompletion(sessionId: string, completionData: any) {
    const session = await db.route_ar_sessions.findFirst({
      where: { id: sessionId }
    })

    if (!session) {
      throw new Error('AR session not found')
    }

    await db.route_ar_sessions.update({
      where: { id: sessionId },
      data: {
        end_time: new Date(),
        duration_seconds: Math.floor((new Date().getTime() - new Date(session.start_time).getTime()) / 1000),
        interactions: completionData.interactions,
        ar_objects_placed: completionData.arObjectsPlaced
      }
    })

    // Trigger waypoint completion
    const progress = await db.user_route_progress.findFirst({
      where: {
        user_id: session.user_id,
        route_id: session.waypoint.route_id
      }
    })

    if (progress) {
      await megaRoutesService.completeWaypoint(
        progress.id,
        session.waypoint_id,
        {
          arInteractions: completionData.interactions,
          timeSpentSeconds: Math.floor((new Date().getTime() - new Date(session.start_time).getTime()) / 1000)
        }
      )
    }

    return { success: true }
  },

  async getNearbyVRUsers(routeId: string) {
    // Find other users currently in VR on the same route
    const activeSessions = await db.route_vr_sessions.findMany({
      where: {
        route_id: routeId,
        end_time: null,
        start_time: {
          gte: new Date(Date.now() - 30 * 60 * 1000) // Last 30 minutes
        }
      },
      include: {
        user: {
          select: {
            id: true,
            profile: true
          }
        }
      }
    })

    return activeSessions.map(session => ({
      userId: session.user.id,
      username: session.user.profile?.display_name,
      avatar: session.user.profile?.avatar_url,
      sessionStart: session.start_time,
      currentWaypoint: this.estimateCurrentWaypoint(session)
    }))
  }
}
