-- Automated valuation updates
CREATE OR REPLACE FUNCTION update_ward_valuations()
RETURNS void AS $$
BEGIN
  UPDATE geo_sovereignty_wards 
  SET 
    current_valuation = base_valuation * (
      1 + 
      (commission_wallet_balance / base_valuation * 0.3) +
      (upgrade_fund_balance / base_valuation * 0.2) + 
      (GREATEST(0, (daily_commission_flow - LAG(daily_commission_flow) OVER w) / LAG(daily_commission_flow) OVER w) * 0.5))
    ),
    updated_at = NOW()
  FROM (
    SELECT 
      ward_id,
      AVG(commission_volume) as avg_commission,
      AVG(user_activity_level) as avg_activity
    FROM ward_valuation_history 
    WHERE valuation_date >= CURRENT_DATE - 30
    GROUP BY ward_id
  ) AS history
  WHERE geo_sovereignty_wards.ward_id = history.ward_id;
END;
$$ LANGUAGE plpgsql;
