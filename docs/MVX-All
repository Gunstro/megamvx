          Claim Rewards
        </button>
      </div>
    )
  }

  const question = game.gameplay_mechanics.questions[currentQuestion]

  return (
    <div className="bg-slate-800/50 border border-slate-700 rounded-2xl p-6">
      {/* Game Header */}
      <div className="flex items-center justify-between mb-6">
        <div>
          <h3 className="font-bold text-white">{game.title}</h3>
          <p className="text-slate-400 text-sm">Question {currentQuestion + 1} of {game.gameplay_mechanics.questions.length}</p>
        </div>
        <div className="text-right">
          <div className="text-2xl font-bold text-yellow-400">{score}</div>
          <div className="text-slate-400 text-sm">Score</div>
        </div>
      </div>

      {/* Timer */}
