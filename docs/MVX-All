CREATE OR REPLACE FUNCTION process_visa_sale_commission(
  buyer_id UUID,
  seller_id UUID, 
  visa_tier_id UUID
) RETURNS DECIMAL AS $$
DECLARE
  upfront_cost DECIMAL;
  one_time_commission DECIMAL;
BEGIN
  -- Get upfront cost
  SELECT upfront_cost INTO upfront_cost FROM visa_tiers WHERE id = visa_tier_id;
  
  -- Calculate 35% commission
  one_time_commission := upfront_cost * 0.35;
  
  -- Record the sale
  INSERT INTO visa_sales (buyer_user_id, seller_user_id, visa_tier_id, upfront_amount)
  VALUES (buyer_id, seller_id, visa_tier_id, upfront_cost);
  
  -- Pay one-time commission
  INSERT INTO commission_ledger (...)
  VALUES (buyer_id, seller_id, one_time_commission, 0, 'one_time', upfront_cost, 'visa_sale');
  
  -- Update seller's balance
  UPDATE user_profiles 
  SET current_balance = current_balance + one_time_commission,
      total_earnings = total_earnings + one_time_commission
  WHERE id = seller_id;
  
  RETURN one_time_commission;
END;
$$ LANGUAGE plpgsql;
