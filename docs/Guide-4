// lib/megaroutes-service.ts
export const megaRoutesService = {
  async createRoute(routeData: any, creatorId: string) {
    const route = await db.megamall_routes.create({
      data: {
        ...routeData,
        creator_id: creatorId,
        status: 'draft'
      }
    })

    // Generate VR environment for the route
    const vrEnvironment = await this.generateVREenvironment(route)
    await db.megamall_routes.update({
      where: { id: route.id },
      data: { vr_environment_url: vrEnvironment.url }
    })

    return route
  },

  async addWaypointToRoute(routeId: string, waypointData: any) {
    const route = await db.megamall_routes.findFirst({
      where: { id: routeId }
    })

    if (!route) {
      throw new Error('Route not found')
    }

    // Get the next waypoint number
    const lastWaypoint = await db.route_waypoints.findFirst({
      where: { route_id: routeId },
      orderBy: { waypoint_number: 'desc' }
    })

    const waypointNumber = (lastWaypoint?.waypoint_number || 0) + 1

    const waypoint = await db.route_waypoints.create({
      data: {
        route_id: routeId,
        waypoint_number: waypointNumber,
        ...waypointData
      }
    })

    // Generate AR experience if specified
    if (waypointData.ar_experience) {
      const arExperience = await this.generateARExperience(waypoint)
      await db.route_waypoints.update({
        where: { id: waypoint.id },
        data: { ar_experience: arExperience }
      })
    }

    return waypoint
  },

  async startRouteForUser(routeId: string, userId: string, options: any = {}) {
    const route = await db.megamall_routes.findFirst({
      where: { id: routeId, is_active: true },
      include: {
        waypoints: {
          orderBy: { waypoint_number: 'asc' }
        }
      }
    })

    if (!route) {
      throw new Error('Route not found or inactive')
    }

    // Check if user already has active progress
    const existingProgress = await db.user_route_progress.findFirst({
      where: {
        user_id: userId,
        route_id: routeId,
        status: 'active'
      }
    })

    if (existingProgress) {
      return existingProgress
    }

    // Process payment if route isn't free
    if (route.base_price > 0) {
      const paymentResult = await geographicWalletService.processRoutePayment(
        userId,
        route.base_price,
        'route_access'
      )

      if (!paymentResult.success) {
        throw new Error(`Payment failed: ${paymentResult.error}`)
      }
    }

    // Create user progress
    const progress = await db.user_route_progress.create({
      data: {
        user_id: userId,
        route_id: routeId,
        current_waypoint: 1,
        total_waypoints: route.waypoints.length,
        progress_percentage: 0,
        route_data: route, // Snapshot of route at start
        status: 'active'
      }
    })

    // Start VR session if requested
    if (options.startInVR) {
      const vrSession = await vrArService.startRouteVRSession(userId, routeId)
      await db.user_route_progress.update({
        where: { id: progress.id },
        data: { vr_session_id: vrSession.sessionId }
      })
    }

    return progress
  },

  async completeWaypoint(progressId: string, waypointId: string, completionData: any) {
    const [progress, waypoint] = await Promise.all([
      db.user_route_progress.findFirst({ where: { id: progressId } }),
      db.route_waypoints.findFirst({ where: { id: waypointId } })
    ])

    if (!progress || !waypoint) {
      throw new Error('Progress or waypoint not found')
    }

    // Record completion
    const completion = await db.route_waypoint_completions.create({
      data: {
        user_route_progress_id: progressId,
        waypoint_id: waypointId,
        time_spent_seconds: completionData.timeSpentSeconds || 0,
        xp_earned: waypoint.reward_xp,
        mb_earned: waypoint.reward_mb,
        ar_interactions: completionData.arInteractions || {},
        vr_interactions: completionData.vrInteractions || {},
        quiz_score: completionData.quizScore,
        media_consumed: completionData.mediaConsumed || [],
        completion_data: completionData
      }
    })

    // Update progress
    const newCompleted = progress.completed_waypoints + 1
    const newPercentage = Math.round((newCompleted / progress.total_waypoints) * 100)
    const nextWaypoint = newCompleted + 1

    await db.user_route_progress.update({
      where: { id: progressId },
      data: {
        completed_waypoints: newCompleted,
        current_waypoint: nextWaypoint > progress.total_waypoints ? progress.total_waypoints : nextWaypoint,
        progress_percentage: newPercentage,
        total_xp_earned: progress.total_xp_earned + waypoint.reward_xp,
        total_mb_earned: progress.total_mb_earned + waypoint.reward_mb,
        last_activity: new Date()
      }
    })

    // Award rewards
    if (waypoint.reward_mb > 0) {
      await geographicWalletService.awardRouteReward(
        progress.user_id,
        waypoint.reward_mb,
        `Waypoint completion: ${waypoint.name}`
      )
    }

    // Check if route is completed
    if (newCompleted === progress.total_waypoints) {
      await this.completeRoute(progressId)
    }

    return completion
  },

  async completeRoute(progressId: string) {
    const progress = await db.user_route_progress.findFirst({
      where: { id: progressId }
    })

    if (!progress) {
      throw new Error('Progress not found')
    }

    // Award completion bonus
    const route = await db.megamall_routes.findFirst({
      where: { id: progress.route_id }
    })

    const completionBonus = this.calculateCompletionBonus(route, progress)
    
    if (completionBonus.xp > 0 || completionBonus.mb > 0) {
      await geographicWalletService.awardRouteReward(
        progress.user_id,
        completionBonus.mb,
        `Route completion: ${route.name}`
      )

      await db.user_route_progress.update({
        where: { id: progressId },
        data: {
          total_xp_earned: progress.total_xp_earned + completionBonus.xp,
          total_mb_earned: progress.total_mb_earned + completionBonus.mb
        }
      })
    }

    // Update progress as completed
    await db.user_route_progress.update({
      where: { id: progressId },
      data: {
        status: 'completed',
        completion_time: new Date(),
        progress_percentage: 100
      }
    })

    // Award achievement
    await achievementsService.awardRouteCompletionAchievement(
      progress.user_id,
      progress.route_id
    )

    return { success: true, bonus: completionBonus }
  },

  async generateVREnvironment(route: any) {
    const vrServiceUrl = process.env.VR_ROUTES_SERVICE_URL
    
    const response = await fetch(`${vrServiceUrl}/generate-route-environment`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        routeId: route.id,
        routeName: route.name,
        routeType: route.route_type,
        waypoints: route.waypoints,
        theme: route.theme_settings
      })
    })

    const { vrEnvironmentUrl, assets } = await response.json()
    return { url: vrEnvironmentUrl, assets }
  },

  async generateARExperience(waypoint: any) {
    const arServiceUrl = process.env.AR_ROUTES_SERVICE_URL
    
    const response = await fetch(`${arServiceUrl}/generate-waypoint-experience`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        waypointId: waypoint.id,
        waypointName: waypoint.name,
        waypointType: waypoint.type,
