// lib/megasocial-service.ts
export const megaSocialService = {
  async createSocialProfile(userId: string, profileData: any) {
    const user = await db.users.findFirst({ where: { id: userId } })
    const existingProfile = await db.social_profiles.findFirst({
      where: { user_id: userId }
    })

    if (existingProfile) {
      return await db.social_profiles.update({
        where: { id: existingProfile.id },
        data: profileData
      })
    }

    return await db.social_profiles.create({
      data: {
        user_id: userId,
        headline: profileData.headline || `MVX Explorer - ${user?.username}`,
        bio: profileData.bio || 'Building the future of commerce and community',
        privacy_settings: {
          profile_visibility: 'public',
          activity_feed: 'friends',
          territory_visibility: 'friends',
          business_visibility: 'public',
          route_progress: 'friends'
        },
        ...profileData
      }
    })
  },

  async createPost(userId: string, postData: any) {
    const post = await db.social_posts.create({
      data: {
        user_id: userId,
        ...postData
      }
    })

    // Auto-generate engagement based on content type
    await this.autoEngageWithPost(post)

    // Notify tagged users
    if (postData.tagged_users && postData.tagged_users.length > 0) {
      await this.notifyTaggedUsers(post.id, postData.tagged_users)
    }

    // Update user's social analytics
    await this.updateSocialAnalytics(userId)

    return post
  },

  async createConnection(userId: string, connectionId: string, connectionType: string = 'friend') {
    // Check for existing connection
    const existing = await db.social_connections.findFirst({
      where: {
        user_id: userId,
        connection_id: connectionId
      }
    })

    if (existing) {
      return await db.social_connections.update({
        where: { id: existing.id },
        data: {
          connection_type: connectionType,
          last_interaction: new Date()
        }
      })
    }

    // Calculate initial connection strength
    const connectionStrength = await this.calculateConnectionStrength(userId, connectionId)

    return await db.social_connections.create({
      data: {
        user_id: userId,
        connection_id: connectionId,
        connection_type: connectionType,
        connection_level: connectionStrength.level,
        mutual_interests: connectionStrength.mutualInterests,
        shared_territories: connectionStrength.sharedTerritories,
        shared_businesses: connectionStrength.sharedBusinesses,
        trust_score: connectionStrength.trustScore
      }
    })
  },

  async calculateConnectionStrength(userId: string, connectionId: string) {
    const [
      userProfile,
      connectionProfile,
      sharedTerritories,
      sharedBusinesses,
      mutualConnections
    ] = await Promise.all([
      db.social_profiles.findFirst({ where: { user_id: userId } }),
      db.social_profiles.findFirst({ where: { user_id: connectionId } }),
      this.getSharedTerritories(userId, connectionId),
      this.getSharedBusinesses(userId, connectionId),
      this.getMutualConnections(userId, connectionId)
    ])

    // Calculate mutual interests
    const userInterests = userProfile?.interests || []
    const connectionInterests = connectionProfile?.interests || []
    const mutualInterests = userInterests.filter(interest => 
      connectionInterests.includes(interest)
    )

    // Calculate trust score (0-1)
    let trustScore = 0.5 // Base score

    // Add points for shared territories
    trustScore += sharedTerritories.length * 0.1

    // Add points for shared businesses
    trustScore += sharedBusinesses.length * 0.15

    // Add points for mutual connections
    trustScore += Math.min(mutualConnections.length * 0.05, 0.3)

    // Add points for mutual interests
    trustScore += Math.min(mutualInterests.length * 0.02, 0.2)

    trustScore = Math.min(trustScore, 1.0)

    // Calculate connection level (1-10)
    const connectionLevel = Math.floor(trustScore * 10) || 1

    return {
      level: connectionLevel,
      mutualInterests,
      sharedTerritories: sharedTerritories.map(t => t.id),
      sharedBusinesses: sharedBusinesses.map(b => b.id),
      trustScore
    }
  },

  async tipUser(fromUserId: string, toUserId: string, amount: number, message?: string, postId?: string) {
    // Process payment through geographic wallet
    const paymentResult = await geographicWalletService.processSocialPayment(
      fromUserId,
      toUserId,
      amount,
      'social_tip'
    )

    if (!paymentResult.success) {
      throw new Error(`Tip payment failed: ${paymentResult.error}`)
    }

    // Record tip
    const tip = await db.social_tipping.create({
      data: {
        from_user_id: fromUserId,
        to_user_id: toUserId,
        post_id: postId,
        amount: amount,
        message: message,
        hedera_transaction_id: paymentResult.transactionId
      }
    })

    // Update post engagement if applicable
    if (postId) {
      await db.social_posts.update({
        where: { id: postId },
        data: {
          engagement_stats: {
            tip_amount: { increment: amount }
          }
        }
      })
    }

    // Send notification to recipient
    await notificationService.sendNotification(toUserId, {
      type: 'tip_received',
      title: 'You received a tip!',
      message: `${await this.getUserDisplayName(fromUserId)} sent you ${amount} MB`,
      data: { tipId: tip.id, fromUserId, amount }
    })

    return tip
  },

  async boostPost(userId: string, postId: string, boostType: string, amount: number) {
    const paymentResult = await geographicWalletService.processSocialPayment(
      userId,
      'platform', // Platform receives boost payments
      amount,
      'post_boost'
    )

    if (!paymentResult.success) {
      throw new Error(`Boost payment failed: ${paymentResult.error}`)
    }

    const boost = await db.social_boosts.create({
      data: {
        user_id: userId,
        post_id: postId,
        boost_type: boostType,
        boost_amount: amount,
        duration_hours: 24,
        reach_multiplier: this.calculateReachMultiplier(amount, boostType)
      }
    })

    // Apply boost to post visibility
    await this.applyPostBoost(postId, boost)

    return boost
  },

  async getPersonalizedFeed(userId: string, options: any = {}) {
    const {
      page = 1,
      limit = 20,
      contentTypes = ['all'],
      sources = ['connections', 'groups', 'territories']
    } = options

    // Get user's social graph
    const socialGraph = await this.buildSocialGraph(userId)

    // Build feed query based on social graph and preferences
    const feedPosts = await this.queryPersonalizedFeed(userId, socialGraph, {
      page,
      limit,
      contentTypes,
      sources
    })

    // Enhance posts with engagement data and user context
    const enhancedPosts = await this.enhanceFeedPosts(feedPosts, userId)

    return {
      posts: enhancedPosts,
      pagination: {
        page,
        limit,
        hasMore: enhancedPosts.length === limit
      },
      socialContext: {
        connectionCount: socialGraph.connections.length,
        groupCount: socialGraph.groups.length,
        territoryCount: socialGraph.territories.length
      }
    }
  },

  async buildSocialGraph(userId: string) {
    const [
      connections,
      groups,
      territories,
      businesses,
      activeRoutes
    ] = await Promise.all([
      db.social_connections.findMany({
        where: { user_id: userId, is_active: true },
        include: { connection: { include: { profile: true } } }
      }),
      db.group_memberships.findMany({
        where: { user_id: userId, is_active: true },
        include: { group: true }
      }),
      territoryService.getUserTerritories(userId),
      businessService.getUserBusinesses(userId),
      megaRoutesService.getUserActiveRoutes(userId)
    ])

    return {
      connections: connections.map(c => ({
        id: c.connection_id,
        type: c.connection_type,
        level: c.connection_level,
        trustScore: c.trust_score,
        user: c.connection
      })),
      groups: groups.map(g => g.group),
      territories,
      businesses,
      routes: activeRoutes
    }
  }
