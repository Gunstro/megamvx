BEGIN
  UPDATE profiles 
  SET 
    total_points = get_user_points(NEW.user_id),
    loyalty_tier = CASE 
      WHEN get_user_points(NEW.user_id) >= 5000 THEN 'platinum'
      WHEN get_user_points(NEW.user_id) >= 2000 THEN 'gold'
      WHEN get_user_points(NEW.user_id) >= 500 THEN 'silver'
      ELSE 'bronze'
    END
  WHERE id = NEW.user_id;
  RETURN NEW;
END;
$$ LANGUAGE plpgsql;

