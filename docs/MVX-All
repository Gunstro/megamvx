// lib/gamified-ads-service.ts
export const gamifiedAdsService = {
  async createBrandQuest(advertiserId: string, questData: any) {
    const quest = await db.advertising_quests.create({
      data: {
        advertiser_id: advertiserId,
        quest_type: 'brand_awareness',
        ...questData
      }
    })

    // Generate interactive storyline
    const storyline = await this.generateQuestStoryline(questData)
    await db.advertising_quests.update({
      where: { id: quest.id },
      data: { quest_storyline: storyline }
    })

    // Create associated leaderboard
    const leaderboard = await this.createQuestLeaderboard(quest.id)

    return { quest, leaderboard }
  },

  async generateQuestStoryline(questData: any) {
    const aiServiceUrl = process.env.AI_QUEST_SERVICE_URL
    
    const response = await fetch(`${aiServiceUrl}/generate-quest-storyline`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        brand: questData.advertiser.business_name,
        product: questData.campaign_title,
        questType: questData.quest_type,
        targetAudience: questData.target_audience
      })
    })

    const { storyline, characters, plotTwists } = await response.json()
    return {
      storyline,
      characters,
      plotTwists,
      interactiveElements: this.generateInteractiveElements(plotTwists)
    }
  },

  async startUserQuest(userId: string, questId: string) {
    const [quest, userProfile] = await Promise.all([
      db.advertising_quests.findFirst({ where: { id: questId, is_active: true } }),
      db.user_advertising_profiles.findFirst({ where: { user_id: userId } })
    ])

    if (!quest) {
      throw new Error('Quest not available')
    }

    if (userProfile.advertising_level < quest.required_level) {
      throw new Error(`Level ${quest.required_level} required to start this quest`)
    }

    const progress = await db.user_quest_progress.create({
      data: {
        user_id: userId,
        quest_id: questId,
        total_stages: this.calculateQuestStages(quest),
        status: 'active'
      }
    })

    // Send welcome notification with storyline
    await notificationService.sendQuestStartNotification(userId, quest)

    return {
      progress,
      quest: {
        ...quest,
        currentStage: 1,
        storyline: quest.quest_storyline
      }
    }
  },

  async completeQuestStage(userId: string, progressId: string, stageData: any) {
    const progress = await db.user_quest_progress.findFirst({
      where: { id: progressId, user_id: userId }
    })

    if (!progress) {
      throw new Error('Progress not found')
    }

    // Calculate stage performance
    const performance = this.calculateStagePerformance(stageData)
    const stageRewards = this.calculateStageRewards(progress.quest, performance)

    // Update progress
    const newStage = progress.current_stage + 1
    const isQuestComplete = newStage > progress.total_stages

    const updatedProgress = await db.user_quest_progress.update({
      where: { id: progressId },
      data: {
        current_stage: newStage,
        completed_stages: progress.completed_stages + 1,
        progress_percentage: Math.round((newStage / progress.total_stages) * 100),
        score: progress.score + performance.score,
        time_spent_seconds: progress.time_spent_seconds + (stageData.timeSpent || 0),
        accuracy_percentage: this.calculateNewAccuracy(progress.accuracy_percentage, performance.accuracy),
        xp_earned: progress.xp_earned + stageRewards.xp,
        mb_earned: progress.mb_earned + stageRewards.mb,
        status: isQuestComplete ? 'completed' : 'active',
        completed_at: isQuestComplete ? new Date() : null
      }
    })

    // Award rewards
    if (stageRewards.xp > 0 || stageRewards.mb > 0) {
      await this.awardUserRewards(userId, stageRewards, `Quest stage completion`)
    }

    // Update leaderboard
    if (isQuestComplete) {
      await this.updateQuestLeaderboard(userId, progress.quest_id, updatedProgress.score)
    }

    return {
      progress: updatedProgress,
      stageRewards,
      isQuestComplete,
      nextStage: isQuestComplete ? null : await this.getNextStageData(progress.quest_id, newStage)
    }
  },

  async createInteractiveAdGame(advertiserId: string, gameData: any) {
    const game = await db.advertising_games.create({
      data: {
        advertiser_id: advertiserId,
        ...gameData
      }
    })

    // Generate game assets
    const gameAssets = await this.generateGameAssets(gameData)
    await db.advertising_games.update({
      where: { id: game.id },
      data: { gameplay_mechanics: gameAssets }
    })

    return game
  },

  async generateGameAssets(gameData: any) {
    switch (gameData.game_type) {
      case 'trivia':
        return await this.generateTriviaGame(gameData)
      case 'puzzle':
        return await this.generatePuzzleGame(gameData)
      case 'memory':
        return await this.generateMemoryGame(gameData)
      case 'creative':
        return await this.generateCreativeGame(gameData)
      case 'discovery':
        return await this.generateDiscoveryGame(gameData)
      default:
        throw new Error('Unsupported game type')
    }
  },

  async generateTriviaGame(gameData: any) {
    const questions = await this.generateBrandTriviaQuestions(
      gameData.advertiser,
      gameData.difficulty_level,
      gameData.question_count || 10
    )

    return {
      type: 'trivia',
      questions,
      timePerQuestion: 30,
      scoring: {
        correctAnswer: 100,
        timeBonus: 50,
        streakBonus: 25
      },
      powerUps: [
        { name: '50-50', description: 'Remove two wrong answers', cost: 50 },
        { name: 'Extra Time', description: '+15 seconds', cost: 30 },
        { name: 'Double Points', description: '2x points next question', cost: 100 }
      ]
    }
  },

  async generateBrandTriviaQuestions(advertiser: any, difficulty: string, count: number) {
    const aiServiceUrl = process.env.AI_TRIVIA_SERVICE_URL
    
    const response = await fetch(`${aiServiceUrl}/generate-brand-trivia`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        brand: advertiser.business_name,
        industry: advertiser.industry,
        products: advertiser.products,
        difficulty,
        count
      })
    })

    return await response.json()
  },

  async playAdGame(userId: string, gameId: string, gameSession: any) {
    const [game, userProfile] = await Promise.all([
      db.advertising_games.findFirst({ where: { id: gameId } }),
      db.user_advertising_profiles.findFirst({ where: { user_id: userId } })
    ])

    // Calculate score based on game performance
    const score = this.calculateGameScore(game, gameSession)
    const rewards = this.calculateGameRewards(game, score, userProfile.advertising_level)

    // Update user stats
    await db.user_advertising_profiles.update({
      where: { user_id: userId },
      data: {
        total_xp: { increment: rewards.xp },
        games_played: { increment: 1 },
        average_engagement_rate: this.calculateNewEngagementRate(userProfile.average_engagement_rate, gameSession.engagement)
      }
    })

    // Award rewards
    await this.awardUserRewards(userId, rewards, `Game completion: ${game.title}`)

    // Update leaderboard if enabled
    if (game.leaderboard_enabled) {
      await this.updateGameLeaderboard(userId, gameId, score)
    }

    // Record brand engagement for advertiser analytics
    await this.recordBrandEngagement(game.advertiser_id, userId, 'game_play', {
      gameId: game.id,
      score,
      duration: gameSession.duration,
      engagement: gameSession.engagement
    })

    return {
      score,
      rewards,
      performance: this.calculatePerformanceTier(score),
      rank: await this.getUserGameRank(userId, gameId)
    }
  },

  async getPersonalizedAdventureFeed(userId: string) {
    const userProfile = await db.user_advertising_profiles.findFirst({
      where: { user_id: userId }
    })

    const [recommendedQuests, activeGames, leaderboards, dailyChallenges] = await Promise.all([
      this.getRecommendedQuests(userProfile),
      this.getActiveGames(userProfile),
      this.getRelevantLeaderboards(userId),
      this.getDailyChallenges()
    ])

    return {
      featuredQuest: recommendedQuests[0],
      recommendedQuests: recommendedQuests.slice(1, 4),
      activeGames,
      leaderboards,
      dailyChallenges,
      userStats: {
        level: userProfile.advertising_level,
        xp: userProfile.total_xp,
        nextLevelXp: this.calculateNextLevelXP(userProfile.advertising_level),
        questsCompleted: userProfile.quests_completed,
        rank: await this.getGlobalRank(userId)
      }
    }
  },

  async awardUserRewards(userId: string, rewards: any, reason: string) {
    // Award XP
    await db.user_advertising_profiles.update({
      where: { user_id: userId },
      data: {
        total_xp: { increment: rewards.xp }
      }
    })

    // Award MB tokens
    if (rewards.mb > 0) {
      await geographicWalletService.awardAdvertisingReward(
        userId,
        rewards.mb,
        reason
      )
    }

    // Check for level up
    const newLevel = await this.checkLevelUp(userId)

    // Award special rewards
    if (rewards.special) {
      await this.awardSpecialRewards(userId, rewards.special)
    }

    return { xp: rewards.xp, mb: rewards.mb, levelUp: newLevel }
  },

  async checkLevelUp(userId: string) {
    const userProfile = await db.user_advertising_profiles.findFirst({
      where: { user_id: userId }
    })

    const xpForNextLevel = this.calculateNextLevelXP(userProfile.advertising_level)
    
    if (userProfile.total_xp >= xpForNextLevel) {
      const newLevel = userProfile.advertising_level + 1
      
      await db.user_advertising_profiles.update({
        where: { user_id: userId },
        data: {
          advertising_level: newLevel
        }
      })

      // Award level-up rewards
      await this.awardLevelUpRewards(userId, newLevel)

      return newLevel
    }

    return null
  },

  calculateNextLevelXP(currentLevel: number): number {
    return Math.floor(1000 * Math.pow(1.5, currentLevel - 1))
  }
}
