    return {
      arLaunchUrl: `megatoncities-ar://experience/${product.id}`,
      webArUrl: `${process.env.AR_WEB_URL}/preview/${product.id}`,
      experience: arExperience
    }
  },

  async handleVRInteraction(sessionId: string, interaction: any) {
    await db.vr_sessions.update({
      where: { id: sessionId },
      data: {
        interactions_count: { increment: 1 }
      }
    })

    // Log detailed interaction for analytics
    await db.vr_interactions.create({
      data: {
        session_id: sessionId,
        interaction_type: interaction.type,
        target_object: interaction.target,
        duration: interaction.duration,
        metadata: interaction.metadata
      }
    })

    // Real-time product recommendations based on VR behavior
    if (interaction.type === 'product_view') {
      await this.suggestRelatedProducts(sessionId, interaction.target)
    }
  }
}
