// Accessibility-Optimized Frag Card
function AccessibilityFragCard({ frag, accessibilityProfile, onStartVisit, highlightedAdaptation }: any) {
  const getAdaptationStrength = (adaptationType: string) => {
    switch (adaptationType) {
      case 'visual':
        return frag.accessibility_features?.audio_descriptions ? 95 : 60
      case 'auditory':
        return frag.accessibility_features?.visual_alerts ? 90 : 55
      case 'mobility':
        return frag.accessibility_features?.wheelchair_accessible ? 98 : 50
      case 'cognitive':
        return frag.accessibility_features?.simplified_navigation ? 92 : 58
      default:
        return frag.accessibilityScore || 75
