  }, [currentUserId])

  const loadFeed = async () => {
    setIsLoading(true)
    try {
      const feedData = await megaSocialService.getPersonalizedFeed(currentUserId, {
        limit: 20,
        contentTypes: ['all'],
        sources: ['connections', 'groups', 'territories']
      })
      setFeed(feedData.posts)
    } catch (error) {
      console.error('Failed to load feed:', error)
    } finally {
      setIsLoading(false)
    }
  }

  if (isLoading) {
    return <FeedSkeleton />
  }

  return (
    <div className="space-y-6">
      {feed.map((post) => (
        <SocialPost 
          key={post.id}
          post={post}
          currentUserId={currentUserId}
          onEngagement={loadFeed}
        />
      ))}
    </div>
  )
}

