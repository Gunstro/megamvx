Table 3: matrix_positions - User Matrix Placement
sql
CREATE TABLE matrix_positions (
    -- Primary Identifier
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    
    -- User Reference
    user_id UUID UNIQUE NOT NULL REFERENCES users(id) ON DELETE CASCADE,
    
    -- Position in Matrix
    sponsor_id UUID REFERENCES users(id), -- Immediate upline (NULL for Level 0)
    matrix_level INTEGER NOT NULL CHECK (matrix_level BETWEEN 0 AND 8),
    
    -- For Level 1/2: Specific position tracking
    level_position_number BIGINT, -- Sequential position within level (1..max)
    level_max_positions BIGINT, -- Capacity at this level (20K, 400K, etc.)
    
    -- Visa Information
    visa_tier_id UUID NOT NULL REFERENCES visa_tiers(id),
    visa_acquired_at TIMESTAMPTZ DEFAULT NOW(),
    
    -- Downline Capacity Tracking
    max_downline_capacity INTEGER NOT NULL, -- 20, 10, or 5 based on level
    current_downline_count INTEGER DEFAULT 0 CHECK (current_downline_count >= 0),
    
    -- Position Status
    is_orphan BOOLEAN DEFAULT FALSE, -- System-assigned (no sponsor)
    is_active BOOLEAN DEFAULT TRUE,
    
    -- System Fields
    created_at TIMESTAMPTZ DEFAULT NOW(),
    updated_at TIMESTAMPTZ DEFAULT NOW(),
    
    -- Constraints
    CHECK (current_downline_count <= max_downline_capacity),
    CHECK (
        (matrix_level = 0 AND sponsor_id IS NULL) OR
        (matrix_level > 0 AND sponsor_id IS NOT NULL)
    ),
    
    -- Unique constraint for Level 1/2 positions
    UNIQUE NULLS NOT DISTINCT (matrix_level, level_position_number)
);

-- Indexes (Critical for Performance)
CREATE INDEX idx_matrix_sponsor ON matrix_positions(sponsor_id) WHERE sponsor_id IS NOT NULL;
CREATE INDEX idx_matrix_level ON matrix_positions(matrix_level);
CREATE INDEX idx_matrix_visa_tier ON matrix_positions(visa_tier_id);
CREATE INDEX idx_matrix_active ON matrix_positions(is_active) WHERE is_active = TRUE;
CREATE INDEX idx_matrix_level_position ON matrix_positions(matrix_level, level_position_number) 
    WHERE level_position_number IS NOT NULL;
CREATE INDEX idx_matrix_downline_capacity ON matrix_positions(max_downline_capacity, current_downline_count);

