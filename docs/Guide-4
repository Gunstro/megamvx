// lib/user-profile-service.ts
export const userProfileService = {
  async getCompleteUserProfile(userId: string) {
    const [
      profile,
      visa,
      achievements,
      stats,
      territories,
      businesses,
      megamallAssets,
      activeRoutes
    ] = await Promise.all([
      db.user_profiles.findFirst({ where: { user_id: userId } }),
      db.user_visas.findFirst({ 
        where: { user_id: userId, is_active: true },
        orderBy: { issued_at: 'desc' }
      }),
      db.user_achievements.findMany({ 
        where: { user_id: userId },
        orderBy: { unlocked_at: 'desc' },
        take: 10
      }),
      db.user_stats.findFirst({ where: { user_id: userId } }),
      territoryService.getUserTerritories(userId),
      businessService.getUserBusinesses(userId),
      db.user_megamall_assets.findMany({ 
        where: { user_id: userId, is_active: true }
      }),
      db.user_routes.findMany({ 
        where: { user_id: userId },
        include: { route: true }
      })
    ])

    return {
      profile: profile || await this.createDefaultProfile(userId),
      visa: visa || await this.assignStarterVisa(userId),
      achievements,
      stats: stats || await this.createDefaultStats(userId),
      territories,
      businesses,
      megamallAssets,
      activeRoutes,
      matrixStats: await matrixService.getUserMatrixStats(userId)
    }
  },

  async createDefaultProfile(userId: string) {
    const user = await db.users.findFirst({ where: { id: userId } })
    return await db.user_profiles.create({
      data: {
        user_id: userId,
        display_name: user?.username || `User${userId.substring(0, 8)}`,
        bio: 'Exploring the MegatonCities MVX ecosystem',
        privacy_settings: {
          profile_public: true,
          show_businesses: true,
          show_achievements: true,
          show_network: true
        }
      }
    })
  },

  async assignStarterVisa(userId: string) {
    const starterVisa = {
      visa_type: 'explorer',
      visa_level: 1,
      current_xp: 0,
      required_xp: 1000,
      benefits: {
        commission_boost: 0,
        territory_limit: 1,
        business_limit: 1,
        daily_rewards: true,
        access_tier: 'basic'
      }
    }

    return await db.user_visas.create({
      data: {
        user_id: userId,
        ...starterVisa
      }
    })
  },

  async updateUserStats(userId: string) {
    const [
      territoriesCount,
      businessesCount,
      totalCommissions,
      monthlyRevenue,
      networkSize,
      achievementCount
    ] = await Promise.all([
      db.territories.count({ where: { owner_id: userId } }),
      db.business_listings.count({ where: { user_id: userId } }),
      geographicWalletService.getUserTotalCommissions(userId),
      geographicWalletService.getUserMonthlyRevenue(userId),
      matrixService.getUserNetworkSize(userId),
      db.user_achievements.count({ where: { user_id: userId } })
    ])

    return await db.user_stats.upsert({
      where: { user_id: userId },
      update: {
        territories_owned: territoriesCount,
        businesses_owned: businessesCount,
        total_commissions: totalCommissions,
        monthly_recurring_revenue: monthlyRevenue,
        network_size: networkSize,
        achievement_count: achievementCount,
        last_updated: new Date()
      },
      create: {
        user_id: userId,
        territories_owned: territoriesCount,
        businesses_owned: businessesCount,
        total_commissions: totalCommissions,
        monthly_recurring_revenue: monthlyRevenue,
        network_size: networkSize,
        achievement_count: achievementCount
      }
    })
  }
}
