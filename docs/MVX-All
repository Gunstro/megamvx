      where: { id: websiteId },
      data: { template_id: templateId }
    })

    // Regenerate website with new template
    const htmlContent = subdomainService.generateWebsiteHTML(
      { ...website, template },
      template
    )

    // Redeploy to CDN
    await subdomainService.deployToCDN(website.subdomain, htmlContent)

    return { success: true, message: 'Template applied successfully' }
