CREATE TABLE business_listings (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    user_id UUID NOT NULL, -- Reference to the user who owns the listing
    business_name VARCHAR(255) NOT NULL,
    slogan TEXT,
    description TEXT,
    phone VARCHAR(50),
    email VARCHAR(255),
    website VARCHAR(255), -- Their main site, if any
    subdomain VARCHAR(255) UNIQUE, -- The auto-generated subdomain (e.g., 'acme-plumbing.megatoncities.com')
    created_at TIMESTAMPTZ DEFAULT NOW(),
    updated_at TIMESTAMPTZ DEFAULT NOW()
);

CREATE TABLE advertising_blocks (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    business_id UUID NOT NULL REFERENCES business_listings(id) ON DELETE CASCADE,
    block_number INTEGER NOT NULL CHECK (block_number BETWEEN 1 AND 6),
    is_active BOOLEAN DEFAULT FALSE,
    purchased_at TIMESTAMPTZ DEFAULT NOW(),
    -- We can store the block-specific content here for flexibility
    block_title VARCHAR(255),
    block_content TEXT,
    block_image_url VARCHAR(255)
);

CREATE INDEX idx_blocks_business_id ON advertising_blocks(business_id);
CREATE UNIQUE INDEX idx_one_block_per_number ON advertising_blocks(business_id, block_number);
