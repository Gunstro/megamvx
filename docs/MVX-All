      benefits: {
        commission_boost: 0,
        territory_limit: 1,
        business_limit: 1,
        daily_rewards: true,
        access_tier: 'basic'
      }
    }

    return await db.user_visas.create({
      data: {
        user_id: userId,
        ...starterVisa
      }
    })
  },

