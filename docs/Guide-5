import { ref } from 'vue'
import { supabase } from '@/plugins/supabase'

export const usePilgrimProgress = () => {
  const currentProgress = ref(null)
  const walletBalance = ref(0)

  const loadProgress = async () => {
    const userId = (await supabase.auth.getUser()).data.user?.id
    if (!userId) return

    const { data, error } = await supabase
      .from('pilgrim_progress')
      .select('*')
      .eq('user_id', userId)
      .single()

    if (!error) currentProgress.value = data
  }

  const recordLocationStamp = async (locationId: string) => {
    const userId = (await supabase.auth.getUser()).data.user?.id
    if (!userId) return

    const { error } = await supabase
      .from('pilgrim_progress')
      .update({
        stamped_locations: supabase.sql`array_append(stamped_locations, ${locationId})`
      })
      .eq('user_id', userId)

    return { error }
  }

  const makeSovereignContribution = async (charityId: string, amount: number) => {
    const userId = (await supabase.auth.getUser()).data.user?.id
    if (!userId) return

    // Deduct from wallet first
    const { error: walletError } = await supabase
      .from('user_wallets')
      .update({ balance: supabase.sql`balance - ${amount}` })
      .eq('user_id', userId)

    if (walletError) return { error: walletError }

    // Record contribution
    const { error } = await supabase
      .from('sovereign_contributions')
      .insert({
        user_id: userId,
        charity_id: charityId,
        amount
      })

    return { error }
  }

  return {
    currentProgress,
    walletBalance,
    loadProgress,
    recordLocationStamp,
    makeSovereignContribution
  }
}
