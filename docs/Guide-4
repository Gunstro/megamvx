// Accessibility-Optimized Frag Card
function AccessibilityFragCard({ frag, accessibilityProfile, onStartVisit, highlightedAdaptation }: any) {
  const getAdaptationStrength = (adaptationType: string) => {
    switch (adaptationType) {
      case 'visual':
        return frag.accessibility_features?.audio_descriptions ? 95 : 60
      case 'auditory':
        return frag.accessibility_features?.visual_alerts ? 90 : 55
      case 'mobility':
        return frag.accessibility_features?.wheelchair_accessible ? 98 : 50
      case 'cognitive':
        return frag.accessibility_features?.simplified_navigation ? 92 : 58
      default:
        return frag.accessibilityScore || 75
    }
  }

  const strength = getAdaptationStrength(highlightedAdaptation)

  return (
    <div className="bg-slate-800/50 backdrop-blur-sm border border-slate-700 rounded-2xl p-6">
      <div className="flex items-start justify-between mb-4">
        <h3 className="font-bold text-white text-lg">{frag.name}</h3>
        <div className="text-right">
          <div className="text-green-400 font-bold text-xl">{strength}%</div>
          <div className="text-slate-400 text-xs">Adaptation Score</div>
        </div>
      </div>

      {/* Adaptation Progress */}
      <div className="mb-4">
        <div className="flex justify-between text-sm text-slate-400 mb-2">
          <span>{highlightedAdaptation.charAt(0).toUpperCase() + highlightedAdaptation.slice(1)} Adaptation</span>
          <span>{strength}%</span>
        </div>
        <div className="w-full bg-slate-700 rounded-full h-2">
          <div 
            className="bg-green-500 h-2 rounded-full transition-all duration-500"
            style={{ width: `${strength}%` }}
          />
        </div>
      </div>

      {/* Recommended Experience */}
      <div className="bg-slate-700/50 rounded-xl p-4 mb-4">
        <h4 className="font-semibold text-white text-sm mb-2">Recommended Experience</h4>
        <p className="text-slate-300 text-xs mb-3">
          {highlightedAdaptation === 'visual' && 'Fully audio-described guided tour with high contrast visuals'}
          {highlightedAdaptation === 'auditory' && 'Visual-focused experience with comprehensive captions'}
          {highlightedAdaptation === 'mobility' && 'Completely accessible navigation with automatic pathfinding'}
          {highlightedAdaptation === 'cognitive' && 'Simplified interface with step-by-step guidance'}
        </p>
        <div className="flex space-x-2">
          <button
            onClick={() => onStartVisit?.(frag, 'desktop')}
            className="flex-1 bg-green-600 hover:bg-green-700 text-white py-2 rounded-lg text-xs font-semibold transition-colors"
          >
            Start Optimized Visit
          </button>
        </div>
