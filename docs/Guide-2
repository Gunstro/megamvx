class BluetoothCommissionEngine {
  calculateCommission(deviceData, userRole) {
    const baseValues = {
      common_device: 0.50,    // Standard phones, accessories
      iot_device: 1.00,      // Smart home devices
      beacon_device: 2.00,    // Purpose-built beacons
      vehicle_device: 5.00,   // Car Bluetooth systems
      enterprise_device: 10.00 // Business infrastructure
    };

    let commission = baseValues[deviceData.type] || 0.10;

    // Multipliers
    const multipliers = {
      signal_strength: this.calculateSignalMultiplier(deviceData.rssi),
      location_quality: this.calculateLocationMultiplier(deviceData.accuracy),
      time_multiplier: this.calculateTimeMultiplier(deviceData.timestamp),
      user_tier: this.getUserTierMultiplier(userRole),
      density_bonus: this.calculateDensityBonus(deviceData.location)
    };

    // Apply multipliers
    Object.values(multipliers).forEach(multiplier => {
      commission *= multiplier;
    });

    return Math.min(commission, this.getDailyCap(userRole));
  }

  calculateSignalMultiplier(rssi) {
    // Stronger signal = better commission
    if (rssi > -50) return 2.0;  // Very close
    if (rssi > -70) return 1.5;  // Close
    if (rssi > -85) return 1.0;  // Normal
    return 0.5;  // Weak signal
  }
}
