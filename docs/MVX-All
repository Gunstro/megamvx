// routes/businessListings.js
const express = require('express');
const router = express.Router();
const db = require('../db'); // Your database connection

// Get all active blocks for the main listing page
router.get('/blocks', async (req, res) => {
  try {
    const query = `
      SELECT bl.business_name, bl.slogan, bl.subdomain, ab.block_number, ab.block_title, ab.block_content, ab.block_image_url
      FROM advertising_blocks ab
      JOIN business_listings bl ON ab.business_id = bl.id
      WHERE ab.is_active = TRUE
      ORDER BY ab.block_number, ab.purchased_at;
    `;
    const result = await db.query(query);
    res.json(result.rows);
  } catch (error) {
    console.error(error);
    res.status(500).json({ error: 'Failed to fetch advertising blocks' });
  }
});

// Create a new business listing (initial step)
router.post('/', async (req, res) => {
  const { userId, businessName, slogan, description, phone, email } = req.body;
  
  // Generate a simple subdomain from the business name
  const subdomain = businessName
    .toLowerCase()
    .replace(/[^a-z0-9]/g, '-')
    .replace(/-+/g, '-')
    .substring(0, 63);

  try {
    const query = `
      INSERT INTO business_listings (user_id, business_name, slogan, description, phone, email, subdomain)
      VALUES ($1, $2, $3, $4, $5, $6, $7)
      RETURNING *;
    `;
    const values = [userId, businessName, slogan, description, phone, email, subdomain];
    const result = await db.query(query, values);
    
    res.status(201).json(result.rows[0]);
  } catch (error) {
    console.error(error);
    res.status(500).json({ error: 'Failed to create business listing' });
  }
});

// Purchase an advertising block
