  owner_payout DECIMAL(8,2) DEFAULT 0,
  upgrade_fund_contribution DECIMAL(8,2) DEFAULT 0,
  
  transaction_date TIMESTAMPTZ DEFAULT NOW()
);

-- Automated balance paydown trigger
CREATE OR REPLACE FUNCTION process_ward_commissions()
RETURNS TRIGGER AS $$
BEGIN
  -- Apply 70% to balance paydown until paid off
  -- Then distribute to owner and upgrade fund
  IF NEW.commission_amount > 0 THEN
    UPDATE ward_ownership 
    SET 
      commission_applied = commission_applied + (NEW.commission_amount * 0.7),
      balance_remaining = GREATEST(0, balance_remaining - (NEW.commission_amount * 0.7))
    WHERE ownership_id = NEW.ownership_id;
    
    -- Once paid off, distribute profits
    UPDATE ward_ownership 
    SET 
      revenue_share_percentage = 
        CASE WHEN balance_remaining <= 0 THEN 1.0 ELSE revenue_share_percentage END
    WHERE ownership_id = NEW.ownership_id;
  END IF;
  
  RETURN NEW;
END;
$$ LANGUAGE plpgsql;
