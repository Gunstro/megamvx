sql
CREATE OR REPLACE FUNCTION assign_matrix_position(
  sponsor_id UUID,
  new_user_id UUID,
  visa_tier_id UUID
) RETURNS UUID AS $$
DECLARE
  available_position UUID;
  sponsor_level INTEGER;
  new_level INTEGER;
BEGIN
  -- Get sponsor's level and determine new user's level
  sponsor_level := (SELECT matrix_level FROM user_matrix_positions WHERE user_id = sponsor_id);
  new_level := sponsor_level + 1;
  
  -- Find first available position in sponsor's downline
  SELECT id INTO available_position
  FROM user_matrix_positions
  WHERE upline_user_id = sponsor_id
    AND direct_downlines_count < max_downlines
    AND matrix_level = sponsor_level
  ORDER BY created_at ASC, position_path ASC
  LIMIT 1;
  
  -- If no position found, sponsor's matrix is full
  IF available_position IS NULL THEN
    RAISE EXCEPTION 'Sponsor matrix capacity reached';
  END IF;
  
  -- Assign position to new user
  INSERT INTO user_matrix_positions (...)
  VALUES (new_user_id, visa_tier_id, new_level, ...);
  
  -- Update sponsor's downline count
  UPDATE user_matrix_positions 
  SET direct_downlines_count = direct_downlines_count + 1
  WHERE id = available_position;
  
  RETURN available_position;
END;
$$ LANGUAGE plpgsql;
