CREATE TABLE hierarchical_commission_flow (
  flow_id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
  source_entity_id UUID REFERENCES geo_sovereignty_hierarchy,
  source_type TEXT, -- 'mdp', 'cvb', 'advertising', 'fragment_experience'
  source_id UUID,
  
  -- Commission Distribution
  gross_commission DECIMAL(10,2),
  distribution_breakdown JSONB, -- How commission flows up hierarchy
  
  -- Allocation by Tier
  megafrag_share DECIMAL(10,2),
  megaward_share DECIMAL(10,2),
  megacity_share DECIMAL(10,2),
  megamunicipality_share DECIMAL(10,2),
  megaprovince_share DECIMAL(10,2),
  megacountry_share DECIMAL(10,2),
  megazone_share DECIMAL(10,2),
  
  -- Platform & Reserve
  platform_fee DECIMAL(10,2),
  sovereign_fund DECIMAL(10,2),
  
  processed_at TIMESTAMPTZ DEFAULT NOW()
);

-- Automated commission distribution function
CREATE OR REPLACE FUNCTION distribute_hierarchical_commissions()
RETURNS TRIGGER AS $$
DECLARE
  entity_record RECORD;
  parent_entity RECORD;
  distribution_rates JSONB;
BEGIN
  -- Get the entity where commission originated
  SELECT * INTO entity_record 
  FROM geo_sovereignty_hierarchy 
  WHERE entity_id = NEW.source_entity_id;
  
  -- Calculate distribution rates based on entity type
  distribution_rates := CASE entity_record.entity_type
    WHEN 'megafrag' THEN '{"megafrag": 0.4, "megaward": 0.2, "megacity": 0.15, "megamunicipality": 0.1, "megaprovince": 0.08, "megacountry": 0.05, "megazone": 0.02}'
    WHEN 'megaward' THEN '{"megaward": 0.5, "megacity": 0.2, "megamunicipality": 0.15, "megaprovince": 0.08, "megacountry": 0.05, "megazone": 0.02}'
    -- ... other entity types
  END;
  
  -- Update NEW record with distribution
  NEW.distribution_breakdown := distribution_rates;
  NEW.megafrag_share := NEW.gross_commission * (distribution_rates->>'megafrag')::DECIMAL;
  NEW.megaward_share := NEW.gross_commission * (distribution_rates->>'megaward')::DECIMAL;
  -- ... other tiers
  
  RETURN NEW;
END;
$$ LANGUAGE plpgsql;
