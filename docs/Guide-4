-- MegaRoutes Core Tables
CREATE TABLE megamall_routes (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    name VARCHAR(255) NOT NULL,
    description TEXT,
    route_type VARCHAR(50) NOT NULL, -- 'wine', 'adventure', 'cultural', 'culinary', 'historical'
    category VARCHAR(100) NOT NULL,
    difficulty_level VARCHAR(50) DEFAULT 'beginner', -- beginner, intermediate, advanced, expert
    estimated_duration_minutes INTEGER NOT NULL,
    total_distance_km DECIMAL(8,2),
    start_location JSONB NOT NULL, -- {lat, lng, name, description}
    end_location JSONB NOT NULL,
    theme_settings JSONB NOT NULL DEFAULT '{}',
    cover_image_url VARCHAR(500),
    vr_environment_url VARCHAR(500),
    ar_world_url VARCHAR(500),
    base_price DECIMAL(15,2) NOT NULL,
    currency VARCHAR(10) DEFAULT 'MB',
    is_active BOOLEAN DEFAULT TRUE,
    is_featured BOOLEAN DEFAULT FALSE,
    creator_id UUID REFERENCES users(id),
    territory_id UUID REFERENCES territories(id),
    created_at TIMESTAMPTZ DEFAULT NOW(),
    updated_at TIMESTAMPTZ DEFAULT NOW()
);

CREATE TABLE route_waypoints (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    route_id UUID NOT NULL REFERENCES megamall_routes(id) ON DELETE CASCADE,
    waypoint_number INTEGER NOT NULL,
    name VARCHAR(255) NOT NULL,
    description TEXT,
    location JSONB NOT NULL, -- {lat, lng, altitude, precision}
    type VARCHAR(50) NOT NULL, -- 'checkpoint', 'experience', 'challenge', 'reward'
    ar_experience JSONB, -- {marker_url, model_url, interaction_type, triggers}
    vr_experience JSONB, -- {environment_url, interactions, assets}
    media_content JSONB DEFAULT '[]', -- images, videos, audio guides
    quiz_questions JSONB, -- for educational routes
    reward_xp INTEGER DEFAULT 0,
    reward_mb DECIMAL(15,2) DEFAULT 0,
    unlock_requirements JSONB, -- prerequisites for this waypoint
    estimated_duration_minutes INTEGER DEFAULT 15,
    created_at TIMESTAMPTZ DEFAULT NOW()
);

CREATE TABLE user_route_progress (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    user_id UUID NOT NULL REFERENCES users(id),
    route_id UUID NOT NULL REFERENCES megamall_routes(id),
    current_waypoint INTEGER DEFAULT 1,
    completed_waypoints INTEGER DEFAULT 0,
    total_waypoints INTEGER NOT NULL,
    progress_percentage INTEGER DEFAULT 0,
    total_xp_earned INTEGER DEFAULT 0,
    total_mb_earned DECIMAL(15,2) DEFAULT 0,
    start_time TIMESTAMPTZ DEFAULT NOW(),
    last_activity TIMESTAMPTZ DEFAULT NOW(),
    completion_time TIMESTAMPTZ,
    status VARCHAR(50) DEFAULT 'active', -- active, paused, completed, abandoned
    vr_session_id VARCHAR(100),
    ar_session_id VARCHAR(100),
    route_data JSONB NOT NULL DEFAULT '{}', -- snapshot of route at start
    created_at TIMESTAMPTZ DEFAULT NOW()
);

CREATE TABLE route_waypoint_completions (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    user_route_progress_id UUID NOT NULL REFERENCES user_route_progress(id) ON DELETE CASCADE,
    waypoint_id UUID NOT NULL REFERENCES route_waypoints(id),
    completion_time TIMESTAMPTZ DEFAULT NOW(),
    time_spent_seconds INTEGER DEFAULT 0,
    xp_earned INTEGER DEFAULT 0,
    mb_earned DECIMAL(15,2) DEFAULT 0,
    ar_interactions JSONB DEFAULT '{}',
    vr_interactions JSONB DEFAULT '{}',
    quiz_score DECIMAL(5,2),
    media_consumed JSONB DEFAULT '[]',
    completion_data JSONB DEFAULT '{}'
);

CREATE TABLE route_reviews (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    route_id UUID NOT NULL REFERENCES megamall_routes(id),
    user_id UUID NOT NULL REFERENCES users(id),
    rating INTEGER NOT NULL CHECK (rating >= 1 AND rating <= 5),
