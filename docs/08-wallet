1. Database Functions for Points
sql
-- Calculate user's total points
CREATE OR REPLACE FUNCTION get_user_points(user_uuid UUID)
RETURNS INTEGER AS $$
  SELECT COALESCE(SUM(points), 0)
  FROM loyalty_points 
  WHERE user_id = user_uuid;
$$ LANGUAGE SQL;

-- Update user tier based on points
CREATE OR REPLACE FUNCTION update_user_tier()
RETURNS TRIGGER AS $$
BEGIN
  UPDATE profiles 
  SET 
    total_points = get_user_points(NEW.user_id),
    loyalty_tier = CASE 
      WHEN get_user_points(NEW.user_id) >= 5000 THEN 'platinum'
      WHEN get_user_points(NEW.user_id) >= 2000 THEN 'gold'
      WHEN get_user_points(NEW.user_id) >= 500 THEN 'silver'
      ELSE 'bronze'
    END
  WHERE id = NEW.user_id;
  RETURN NEW;
END;
$$ LANGUAGE plpgsql;

-- Trigger to update tiers automatically
CREATE TRIGGER update_user_tier_trigger
  AFTER INSERT ON loyalty_points
  FOR EACH ROW
  EXECUTE FUNCTION update_user_tier();
