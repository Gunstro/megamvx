class AccuracyRewardsEngine {
  async calculateVerificationAccuracy(propertyId: string): Promise<number> {
    const property = await supabase
      .from('properties')
      .select('*')
      .eq('id', propertyId)
      .single();

    // Score based on data completeness and government match
    let score = 0;
    
    if (property.government_verified) score += 50;
    if (property.community_endorsements >= 3) score += 30;
    if (property.data_completeness === 'high') score += 20;
    
    return score;
  }

  async awardAccuracyPoints(userId: string, propertyId: string) {
    const accuracyScore = await this.calculateVerificationAccuracy(propertyId);
    const points = Math.floor(accuracyScore * 0.1); // Convert to points
    
    await supabase
      .from('loyalty_points')
      .insert({
        user_id: userId,
        points: points,
        transaction_type: 'earn',
        category: 'verification_accuracy',
        description: `Accuracy bonus for property ${propertyId}`,
        metadata: { propertyId, accuracyScore }
      });
  }
}
