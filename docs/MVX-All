// Amenity Badge Component
function AmenityBadge({ amenity }: any) {
  const amenityIcons: { [key: string]: any } = {
    'wifi': Wifi,
    'parking': Car,
    'air_conditioning': Snowflake,
    'kitchen': Utensils,
    'pool': Waves,
    'gym': Dumbbell
  }

  const IconComponent = amenityIcons[amenity] || Home
  const displayName = amenity.split('_').map((word: string) => 
    word.charAt(0).toUpperCase() + word.slice(1)
  ).join(' ')

  return (
    <span className="bg-slate-700/50 text-slate-300 px-2 py-1 rounded text-xs flex items-center space-x-1">
      <IconComponent className="h-3 w-3" />
      <span>{displayName}</span>
    </span>
  )
}

