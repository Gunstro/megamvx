class LocationStoryEngine {
  constructor() {
    this.activeStoryArcs = new Map();
    this.userProgress = new Map();
  }

  startStoryArc(storyArcId, startingLocation) {
    const storyArc = this.getStoryArc(storyArcId);
    this.activeStoryArcs.set(storyArcId, {
      arc: storyArc,
      currentStep: 0,
      startedAt: Date.now()
    });

    this.triggerLocationExperience(startingLocation, storyArc.steps[0]);
  }

  progressStoryArc(storyArcId, completedLocation) {
    const userArc = this.activeStoryArcs.get(storyArcId);
    const currentStep = userArc.currentStep;
    const storyArc = userArc.arc;

    // Verify user completed the correct location
    if (storyArc.steps[currentStep].location_id !== completedLocation) {
      console.warn('User completed wrong location in story arc');
      return;
    }

    // Move to next step
    userArc.currentStep++;

    if (userArc.currentStep >= storyArc.steps.length) {
      this.completeStoryArc(storyArcId);
    } else {
      const nextStep = storyArc.steps[userArc.currentStep];
      this.unlockNextLocation(nextStep.location_id);
    }
  }

  completeStoryArc(storyArcId) {
    const userArc = this.activeStoryArcs.get(storyArcId);
    const rewards = userArc.arc.completion_rewards;
    
    this.awardRewards(rewards);
    this.activeStoryArcs.delete(storyArcId);
    
    // Trigger completion event
    this.emit('storyArcCompleted', { storyArcId, rewards });
  }
}
