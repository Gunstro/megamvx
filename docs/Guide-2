class GeolocationTriggerEngine {
  constructor() {
    this.activeGeofences = new Map();
    this.userLocation = null;
    this.watchId = null;
  }

  startLocationMonitoring() {
    if (!navigator.geolocation) {
      console.error('Geolocation not supported');
      return;
    }

    // High-accuracy, frequent updates for 5m precision
    this.watchId = navigator.geolocation.watchPosition(
      (position) => this.handlePositionUpdate(position),
      (error) => this.handleLocationError(error),
      {
        enableHighAccuracy: true,
        maximumAge: 30000, // 30 seconds max cache
        timeout: 27000     // 27 second timeout
      }
    );
  }

  handlePositionUpdate(position) {
    const newLocation = {
      latitude: position.coords.latitude,
      longitude: position.coords.longitude,
      accuracy: position.coords.accuracy,
      timestamp: position.timestamp
    };

    this.userLocation = newLocation;
    this.checkGeofenceTriggers(newLocation);
  }

  checkGeofenceTriggers(currentLocation) {
    this.activeGeofences.forEach((geofence, cvbId) => {
      const distance = this.calculateDistance(
        currentLocation, 
        geofence.geo_center
      );

      if (distance <= geofence.trigger_radius) {
        this.activateCVB(cvbId, geofence, currentLocation);
      }
    });
  }

  calculateDistance(loc1, loc2) {
    // Haversine formula for precise distance calculation
    const R = 6371000; // Earth radius in meters
    const dLat = this.toRad(loc2.latitude - loc1.latitude);
    const dLon = this.toRad(loc2.longitude - loc1.longitude);
    
    const a = Math.sin(dLat/2) * Math.sin(dLat/2) +
              Math.cos(this.toRad(loc1.latitude)) * 
              Math.cos(this.toRad(loc2.latitude)) *
              Math.sin(dLon/2) * Math.sin(dLon/2);
              
    const c = 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1-a));
    return R * c;
  }
}
