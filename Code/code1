Table 4: user_financials - Financial Tracking
sql
CREATE TABLE user_financials (
    -- Primary Identifier
    user_id UUID PRIMARY KEY REFERENCES users(id) ON DELETE CASCADE,
    
    -- Current Visa Tier
    current_visa_tier_id UUID NOT NULL REFERENCES visa_tiers(id),
    
    -- Wallet System (GBP)
    wallet_balance_gbp DECIMAL(10,2) DEFAULT 0 CHECK (wallet_balance_gbp >= 0),
    pending_balance_gbp DECIMAL(10,2) DEFAULT 0 CHECK (pending_balance_gbp >= 0), -- 10-day hold
    
    -- Monthly Tracking
    current_month_earnings_gbp DECIMAL(10,2) DEFAULT 0 CHECK (current_month_earnings_gbp >= 0),
    current_month_start_date DATE DEFAULT DATE_TRUNC('month', CURRENT_DATE),
    
    -- Monthly Fee Management
    monthly_fee_paid_until DATE,
    next_fee_due_date DATE GENERATED ALWAYS AS (
        COALESCE(monthly_fee_paid_until, CURRENT_DATE) + INTERVAL '1 month'
    ) STORED,
    fee_trigger_met_current_month BOOLEAN DEFAULT FALSE,
    
    -- Upgrade Tracking
    upgrade_savings_gbp DECIMAL(10,2) DEFAULT 0 CHECK (upgrade_savings_gbp >= 0),
    pending_upgrade_to_tier_id UUID REFERENCES visa_tiers(id),
    last_upgrade_date DATE,
    
    -- Lifetime Statistics
    total_earned_gbp DECIMAL(12,2) DEFAULT 0 CHECK (total_earned_gbp >= 0),
    total_withdrawn_gbp DECIMAL(12,2) DEFAULT 0 CHECK (total_withdrawn_gbp >= 0),
    total_upgraded_gbp DECIMAL(12,2) DEFAULT 0 CHECK (total_upgraded_gbp >= 0),
    
    -- System Fields
    last_financial_update TIMESTAMPTZ DEFAULT NOW(),
    created_at TIMESTAMPTZ DEFAULT NOW(),
    updated_at TIMESTAMPTZ DEFAULT NOW(),
    
    -- Constraints
    CHECK (upgrade_savings_gbp <= wallet_balance_gbp),
    CHECK (pending_balance_gbp <= wallet_balance_gbp)
);

-- Indexes
CREATE INDEX idx_financials_visa_tier ON user_financials(current_visa_tier_id);
CREATE INDEX idx_financials_fee_due ON user_financials(next_fee_due_date) 
    WHERE next_fee_due_date IS NOT NULL;
CREATE INDEX idx_financials_month_start ON user_financials(current_month_start_date);
Table 5: commission_events - Commission Triggers
sql
CREATE TABLE commission_events (
    -- Primary Identifier
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    
    -- Purchase Information
    purchaser_user_id UUID NOT NULL REFERENCES users(id),
    purchase_amount_gbp DECIMAL(10,2) NOT NULL CHECK (purchase_amount_gbp > 0),
    purchase_type VARCHAR(50) NOT NULL CHECK (purchase_type IN ('visa', 'product', 'service')),
    
    -- Commission Pools (GBP)
    matrix_commission_pool_gbp DECIMAL(10,2) GENERATED ALWAYS AS (
        purchase_amount_gbp * 0.40
    ) STORED,
    megapartner_commission_pool_gbp DECIMAL(10,2) GENERATED ALWAYS AS (
        purchase_amount_gbp * 0.285
    ) STORED,
    
    -- Timing
    purchased_at TIMESTAMPTZ NOT NULL,
    commission_due_at TIMESTAMPTZ GENERATED ALWAYS AS (
        purchased_at + INTERVAL '10 days'
    ) STORED,
    processed_at TIMESTAMPTZ,
    
    -- Status Tracking
    status VARCHAR(20) DEFAULT 'pending' CHECK (
        status IN ('pending', 'processing', 'completed', 'cancelled', 'failed')
    ),
    retry_count INTEGER DEFAULT 0,
    
    -- Audit
    created_by_system BOOLEAN DEFAULT TRUE,
    error_message TEXT,
    
    created_at TIMESTAMPTZ DEFAULT NOW(),
    updated_at TIMESTAMPTZ DEFAULT NOW(),
    
    -- Constraints
    CHECK (commission_due_at > purchased_at),
    CHECK (processed_at IS NULL OR processed_at >= purchased_at)
);

-- Indexes (Optimized for Commission Processing)
CREATE INDEX idx_comm_events_status_due ON commission_events(status, commission_due_at)
    WHERE status = 'pending';
CREATE INDEX idx_comm_events_purchaser ON commission_events(purchaser_user_id, purchased_at);
CREATE INDEX idx_comm_events_processed ON commission_events(processed_at) 
    WHERE processed_at IS NOT NULL;
CREATE INDEX idx_comm_events_purchase_date ON commission_events(DATE(purchased_at));
Table 6: commission_distributions - Individual Commission Payments
sql
CREATE TABLE commission_distributions (
    -- Primary Identifier
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    
    -- Event Reference
    commission_event_id UUID NOT NULL REFERENCES commission_events(id),
    
    -- Recipient Information
    receiver_user_id UUID NOT NULL REFERENCES users(id),
    receiver_matrix_level INTEGER NOT NULL CHECK (receiver_matrix_level BETWEEN 0 AND 8),
    level_distance INTEGER NOT NULL CHECK (level_distance BETWEEN 1 AND 5),
    
    -- Commission Rates (from commission_rates table)
    commission_rate DECIMAL(5,4) NOT NULL CHECK (commission_rate BETWEEN 0 AND 1),
    
    -- Amounts (GBP)
    calculated_amount_gbp DECIMAL(10,2) NOT NULL CHECK (calculated_amount_gbp >= 0),
    applied_cap_gbp DECIMAL(10,2), -- NULL = no cap applied
    paid_amount_gbp DECIMAL(10,2) NOT NULL CHECK (paid_amount_gbp >= 0),
    surplus_amount_gbp DECIMAL(10,2) DEFAULT 0 CHECK (surplus_amount_gbp >= 0),
    
    -- Cap Application Details
    cap_type VARCHAR(20) CHECK (cap_type IN ('daily', 'weekly', 'monthly', 'lifetime', 'none')),
    cap_applied_at TIMESTAMPTZ,
    
    -- Payment Status
    status VARCHAR(20) DEFAULT 'pending' CHECK (
        status IN ('pending', 'processing', 'paid', 'capped', 'failed', 'surplus')
    ),
    paid_at TIMESTAMPTZ,
    
    -- System Fields
    created_at TIMESTAMPTZ DEFAULT NOW(),
    updated_at TIMESTAMPTZ DEFAULT NOW(),
    
    -- Constraints
    CHECK (paid_amount_gbp + surplus_amount_gbp = calculated_amount_gbp),
    CHECK (paid_at IS NULL OR paid_at >= created_at)
);

-- Indexes (Optimized for Reporting and Queries)
CREATE INDEX idx_comm_dist_receiver ON commission_distributions(receiver_user_id, status);
CREATE INDEX idx_comm_dist_event ON commission_distributions(commission_event_id);
CREATE INDEX idx_comm_dist_level ON commission_distributions(level_distance);
CREATE INDEX idx_comm_dist_paid_date ON commission_distributions(DATE(paid_at)) 
    WHERE paid_at IS NOT NULL;
CREATE INDEX idx_comm_dist_status_created ON commission_distributions(status, created_at);
Table 7: poverty_fund - Surplus Management
sql
CREATE TABLE poverty_fund (
    -- Primary Identifier
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    
    -- Source of Funds
    source_type VARCHAR(50) NOT NULL CHECK (
        source_type IN ('cap_surplus', 'overflow_commission', 'direct_donation', 'company_contribution')
    ),
    source_user_id UUID REFERENCES users(id),
    source_commission_distribution_id UUID REFERENCES commission_distributions(id),
    
    -- Amount (GBP)
    amount_gbp DECIMAL(10,2) NOT NULL CHECK (amount_gbp > 0),
    
    -- Allocation
    allocated_to_megabucks_gbp DECIMAL(10,2) GENERATED ALWAYS AS (amount_gbp * 0.20) STORED,
    allocated_to_relief_gbp DECIMAL(10,2) GENERATED ALWAYS AS (amount_gbp * 0.80) STORED,
    
    -- Status
    status VARCHAR(20) DEFAULT 'accumulated' CHECK (
        status IN ('accumulated', 'allocated', 'distributed', 'reserved')
    ),
    
    -- Distribution Tracking
    distribution_date DATE, -- Monthly distribution date
    distribution_batch_id UUID, -- Links to distribution batch
    
    -- System Fields
    created_at TIMESTAMPTZ DEFAULT NOW(),
    allocated_at TIMESTAMPTZ,
    distributed_at TIMESTAMPTZ,
    
    -- Constraints
    CHECK (allocated_at IS NULL OR allocated_at >= created_at),
    CHECK (distributed_at IS NULL OR distributed_at >= allocated_at)
);

-- Indexes
CREATE INDEX idx_poverty_fund_source ON poverty_fund(source_type, source_user_id);
CREATE INDEX idx_poverty_fund_status ON poverty_fund(status);
