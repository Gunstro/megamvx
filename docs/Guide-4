// middleware/subdomain-handler.ts
import { Request, Response, NextFunction } from 'express'

export const subdomainHandler = async (req: Request, res: Response, next: NextFunction) => {
  const host = req.get('host') || ''
  const subdomain = req.get('x-subdomain') || host.split('.')[0]
  
  // Skip if main domain or www
  if (subdomain === 'www' || subdomain === 'megatoncities' || !subdomain) {
    return next()
  }

  try {
    // Check if this is a valid business subdomain
    const website = await db.business_websites.findFirst({
      where: { 
        subdomain: subdomain,
        status: 'active'
      },
      include: {
        business: {
          select: {
            business_name: true,
            slogan: true,
            description: true,
            phone: true,
            email: true,
            address: true
          }
        },
        pages: {
          where: { is_active: true },
          orderBy: { page_order: 'asc' }
        }
      }
    })

    if (website) {
      // Serve the business website
      const htmlContent = subdomainService.generateWebsiteHTML(website, website.template)
      res.set('Content-Type', 'text/html')
      return res.send(htmlContent)
    }

    // Not a valid subdomain - continue to main app
    next()
  } catch (error) {
    console.error('Subdomain handling error:', error)
    next()
  }
}
