    const multipliers = {
      // Rating Quality Multipliers
      detailedReview: ratingData.comment_length > 200 ? 1.5 : 1.0,
      helpfulVotes: 1 + (ratingData.helpful_votes * 0.1),
      earlyRater: this.isEarlyRating(ratingData) ? 2.0 : 1.0,
      
      // User Credibility Multipliers
      userWeight: ratingData.user_rating_weight,
      consistentRater: this.getConsistencyBonus(ratingData.user_id),
      
      // Entity Importance Multipliers
      entityPopularity: this.getEntityPopularityMultiplier(ratingData.entity_id),
      categoryWeight: ratingData.category_weight
    };
    
    const totalMultiplier = Object.values(multipliers).reduce((a, b) => a * b, 1);
    return baseReward * totalMultiplier;
  }
  
  isEarlyRating(ratingData) {
    // First 100 ratings on any entity get bonus
