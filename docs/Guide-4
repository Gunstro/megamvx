-- Gamified Advertising Core Tables
CREATE TABLE advertising_quests (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    quest_type VARCHAR(50) NOT NULL, -- 'brand_awareness', 'product_launch', 'engagement', 'conversion'
    title VARCHAR(255) NOT NULL,
    description TEXT,
    
    -- Quest Mechanics
    difficulty_level VARCHAR(20) DEFAULT 'beginner', -- beginner, intermediate, advanced, expert
    required_level INTEGER DEFAULT 1,
    time_limit_minutes INTEGER, -- NULL for no time limit
    max_participants INTEGER,
    
    -- Rewards Structure
    base_reward_xp INTEGER NOT NULL,
    bonus_reward_xp INTEGER DEFAULT 0,
    reward_mb DECIMAL(15,2) NOT NULL,
    special_rewards JSONB DEFAULT '[]', -- NFTs, badges, exclusive access
    
    -- Advertising Integration
    advertiser_id UUID NOT NULL REFERENCES users(id),
    campaign_id UUID REFERENCES magazine_advertisements(id),
    target_metrics JSONB DEFAULT '{}', -- {impressions: 1000, clicks: 100, conversions: 10}
    
    -- Quest Content
    quest_storyline TEXT,
    interactive_elements JSONB DEFAULT '[]',
    media_assets JSONB DEFAULT '[]',
    
    -- Status
    is_active BOOLEAN DEFAULT TRUE,
    is_featured BOOLEAN DEFAULT FALSE,
    
    created_at TIMESTAMPTZ DEFAULT NOW()
);

CREATE TABLE user_quest_progress (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    user_id UUID NOT NULL REFERENCES users(id),
    quest_id UUID NOT NULL REFERENCES advertising_quests(id),
    
    -- Progress Tracking
    current_stage INTEGER DEFAULT 1,
    completed_stages INTEGER DEFAULT 0,
    total_stages INTEGER NOT NULL,
    progress_percentage INTEGER DEFAULT 0,
    
    -- Performance Metrics
    score INTEGER DEFAULT 0,
    time_spent_seconds INTEGER DEFAULT 0,
    accuracy_percentage DECIMAL(5,2) DEFAULT 0,
    
    -- Rewards Earned
    xp_earned INTEGER DEFAULT 0,
    mb_earned DECIMAL(15,2) DEFAULT 0,
    bonuses_unlocked JSONB DEFAULT '[]',
    
    -- Status
    status VARCHAR(50) DEFAULT 'active', -- active, completed, failed, abandoned
    started_at TIMESTAMPTZ DEFAULT NOW(),
    completed_at TIMESTAMPTZ,
    
    UNIQUE(user_id, quest_id)
);

-- Advertising Mini-Games
CREATE TABLE advertising_games (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    game_type VARCHAR(50) NOT NULL, -- 'trivia', 'puzzle', 'memory', 'creative', 'discovery'
    title VARCHAR(255) NOT NULL,
    description TEXT,
    
    -- Game Mechanics
    gameplay_mechanics JSONB NOT NULL,
    difficulty_curve JSONB DEFAULT '{}',
    learning_objectives JSONB DEFAULT '[]',
    
    -- Brand Integration
    advertiser_id UUID NOT NULL REFERENCES users(id),
    brand_integration_level VARCHAR(50) DEFAULT 'subtle', -- subtle, balanced, prominent
    product_placement JSONB DEFAULT '[]',
    
    -- Rewards
    base_reward_xp INTEGER NOT NULL,
    performance_multipliers JSONB DEFAULT '{}',
    leaderboard_enabled BOOLEAN DEFAULT TRUE,
    
    created_at TIMESTAMPTZ DEFAULT NOW()
);

-- User Advertising Profiles
CREATE TABLE user_advertising_profiles (
