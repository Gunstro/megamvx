        base_rent_price: 1500,
        total_units: 40,
        available_units: 40,
        theme_settings: {
          primaryColor: '#45B7D1',
          secondaryColor: '#96CEB4',
          backgroundMusic: 'tech-ambient.mp3',
          lighting: 'neon'
        }
      },
      {
        name: 'Virtual Home & Living',
        description: 'Digital furniture and home experiences',
        category: 'home',
        base_rent_price: 800,
        total_units: 60,
        available_units: 60,
        theme_settings: {
          primaryColor: '#A593E0',
          secondaryColor: '#FFCEF3',
          backgroundMusic: 'home-ambient.mp3',
          lighting: 'warm'
        }
      },
      {
        name: 'Entertainment Plaza',
        description: 'Games, NFTs, and digital entertainment',
        category: 'entertainment',
        base_rent_price: 1200,
        total_units: 45,
        available_units: 45,
        theme_settings: {
          primaryColor: '#FF9671',
          secondaryColor: '#FFC75F',
          backgroundMusic: 'entertainment-ambient.mp3',
          lighting: 'party'
        }
      }
    ]

    for (const zoneData of defaultZones) {
      await db.megamall_zones.upsert({
        where: { name: zoneData.name },
        update: {},
        create: zoneData
      })
    }

    return { success: true, message: 'MegaMall initialized' }
  },

  async rentStore(zoneId: string, userId: string, businessId: string | null, storeData: any) {
    const zone = await db.megamall_zones.findFirst({
      where: { id: zoneId, is_active: true }
    })

    if (!zone) {
      throw new Error('Zone not found or inactive')
    }

    if (zone.available_units <= 0) {
      throw new Error('No available units in this zone')
    }

    // Calculate rent price with potential premium for featured locations
    const baseRent = zone.base_rent_price
    const premiumMultiplier = storeData.is_featured ? 1.5 : 1
    const monthlyRent = baseRent * premiumMultiplier

    // Process payment through geographic wallet
    const paymentResult = await geographicWalletService.processMegaMallPayment(
      userId,
      monthlyRent,
      'store_rental'
    )

    if (!paymentResult.success) {
      throw new Error(`Payment failed: ${paymentResult.error}`)
    }

    // Create store
    const store = await db.megamall_stores.create({
      data: {
        zone_id: zoneId,
        user_id: userId,
        business_id: businessId,
        store_name: storeData.store_name,
        store_description: storeData.store_description,
        store_category: storeData.store_category,
        rent_price: monthlyRent,
        store_theme: storeData.store_theme || {},
        opening_date: new Date(),
        is_active: true
      }
    })

    // Update zone availability
    await db.megamall_zones.update({
      where: { id: zoneId },
      data: { available_units: zone.available_units - 1 }
    })

    // Generate VR store environment
    const vrStoreUrl = await this.generateVRStore(store)
    await db.megamall_stores.update({
      where: { id: store.id },
      data: { vr_store_url: vrStoreUrl }
    })

    return {
      store,
      vrStoreUrl,
      transaction: paymentResult,
      message: `Store "${storeData.store_name}" successfully rented for ${monthlyRent} MB/month`
    }
  },

  async generateVRStore(store: any) {
    // Integrate with Three.js/WebXR for VR store generation
    // This would typically call a separate VR rendering service
    const vrServiceUrl = process.env.VR_SERVICE_URL
    
    const response = await fetch(`${vrServiceUrl}/generate-store`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        storeId: store.id,
        storeName: store.store_name,
        theme: store.store_theme,
        category: store.store_category
      })
    })

    const { vrEnvironmentUrl } = await response.json()
    return vrEnvironmentUrl
  },

  async addProductToStore(storeId: string, productData: any) {
    const store = await db.megamall_stores.findFirst({
      where: { id: storeId, is_active: true }
    })

    if (!store) {
      throw new Error('Store not found or inactive')
    }

    const product = await db.virtual_products.create({
      data: {
        store_id: storeId,
        ...productData
      }
    })

    // Generate AR experience if applicable
    if (productData.product_type === 'physical' || productData.product_type === 'virtual') {
      const arExperience = await this.generateARExperience(product)
      await db.ar_experiences.create({
        data: {
          product_id: product.id,
          experience_type: 'preview',
          ar_model_url: arExperience.modelUrl,
          supported_devices: ['ios', 'android', 'web']
        }
      })
    }

    return product
  },

  async purchaseProduct(productId: string, buyerId: string, vrSessionId?: string) {
    const product = await db.virtual_products.findFirst({
      where: { id: productId, is_available: true },
      include: { store: true }
    })

    if (!product) {
      throw new Error('Product not available')
    }

    if (product.inventory_count === 0) {
      throw new Error('Product out of stock')
    }

    // Process payment
    const paymentResult = await geographicWalletService.processMegaMallPayment(
      buyerId,
      product.price,
      'product_purchase'
    )

    if (!paymentResult.success) {
      throw new Error(`Payment failed: ${paymentResult.error}`)
    }

    // Record transaction
    const transaction = await db.megamall_transactions.create({
      data: {
        store_id: product.store_id,
        product_id: productId,
        buyer_id: buyerId,
        transaction_type: 'product_purchase',
        amount: product.price,
        currency: product.currency,
        hedera_transaction_id: paymentResult.transactionId,
        vr_session_id: vrSessionId,
        status: 'completed'
      }
    })

    // Update inventory
    if (product.inventory_count > 0) {
      await db.virtual_products.update({
        where: { id: productId },
        data: { inventory_count: product.inventory_count - 1 }
      })
    }

    // Update store revenue
    await db.megamall_stores.update({
      where: { id: product.store_id },
      data: { 
        monthly_revenue: { increment: product.price },
        visitor_count: { increment: 1 }
      }
    })

    // Handle product delivery based on type
    await this.deliverProduct(product, buyerId)

    return {
      transaction,
      product,
      delivery: await this.getDeliveryStatus(product, buyerId)
    }
  },

  async deliverProduct(product: any, buyerId: string) {
    switch (product.product_type) {
      case 'physical':
        // Integrate with shipping service
        await this.shipPhysicalProduct(product, buyerId)
        break
      case 'digital':
        // Generate download link
        await this.provideDigitalAccess(product, buyerId)
        break
      case 'virtual':
        // Add to user's virtual inventory
        await this.addToVirtualInventory(product, buyerId)
        break
      case 'nft':
        // Mint and transfer NFT
        await this.mintAndTransferNFT(product, buyerId)
        break
    }
  }
}
