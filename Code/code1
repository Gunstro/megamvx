Table 8: upgrade_transactions - Visa Upgrade History
sql
CREATE TABLE upgrade_transactions (
    -- Primary Identifier
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    
    -- User Information
    user_id UUID NOT NULL REFERENCES users(id),
    
    -- Upgrade Details
    from_visa_tier_id UUID NOT NULL REFERENCES visa_tiers(id),
    to_visa_tier_id UUID NOT NULL REFERENCES visa_tiers(id),
    
    -- Financial Details (GBP)
    upgrade_cost_gbp DECIMAL(10,2) NOT NULL CHECK (upgrade_cost_gbp >= 0),
    wallet_balance_before_gbp DECIMAL(10,2) NOT NULL CHECK (wallet_balance_before_gbp >= 0),
    wallet_balance_after_gbp DECIMAL(10,2) NOT NULL CHECK (wallet_balance_after_gbp >= 0),
    
    -- Trigger Information
    trigger_type VARCHAR(20) NOT NULL CHECK (
        trigger_type IN ('auto_free_upgrade', 'user_initiated', 'system_prompted', 'forced_cap')
    ),
    trigger_amount_gbp DECIMAL(10,2), -- Amount that triggered upgrade
    
    -- System Fields
    processed_at TIMESTAMPTZ DEFAULT NOW(),
    created_at TIMESTAMPTZ DEFAULT NOW(),
    
    -- Constraints
    CHECK (to_visa_tier_id != from_visa_tier_id),
    CHECK (wallet_balance_after_gbp = wallet_balance_before_gbp - upgrade_cost_gbp)
);

-- Indexes
CREATE INDEX idx_upgrade_user ON upgrade_transactions(user_id, processed_at);
CREATE INDEX idx_upgrade_from_tier ON upgrade_transactions(from_visa_tier_id);
CREATE INDEX idx_upgrade_to_tier ON upgrade_transactions(to_visa_tier_id);
CREATE INDEX idx_upgrade_date ON upgrade_transactions(DATE(processed_at));
