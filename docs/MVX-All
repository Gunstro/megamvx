create table cammino_locations (
  id uuid primary key default gen_random_uuid(),
  cammino_id text not null,
  name text not null,
  coordinates geography(point) not null,
  type text check (type in ('COMMON', 'IOT', 'BEACON', 'VEHICLE')),
  commission numeric(10,2) not null,
