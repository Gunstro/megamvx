public class ARHistoryManager : MonoBehaviour
{
    public ARSessionOrigin arSessionOrigin;
    public GameObject medievalPrefab;
    public GameObject renaissancePrefab;
    private LocationService locationService;
    
    void Start()
    {
        StartCoroutine(InitializeARSession());
        locationService = Input.location;
        locationService.Start();
    }
    
    public void OnBeaconDiscovered(int beaconMinorId)
    {
        // Fetch AR content from Firestore based on beaconMinorId
        StartCoroutine(LoadARContentForBeacon(beaconMinorId));
    }
    
    private IEnumerator LoadARContentForBeacon(int beaconMinorId)
    {
        var db = FirebaseFirestore.DefaultInstance;
        DocumentReference docRef = db.Collection("arContent").Document(beaconMinorId.ToString());
        
        var getTask = docRef.GetSnapshotAsync();
        
        yield return new WaitUntil(() => getTask.IsCompleted);
        
        if (getTask.Result.Exists)
        {
            Dictionary<string, object> arData = getTask.Result.ToDictionary();
            string era = (string)arData["currentEra"];
            string modelUrl = (string)arData["modelUrl"];
            
            StartCoroutine(SpawnARModel(era, modelUrl));
        }
    }
    
    private IEnumerator SpawnARModel(string era, string modelUrl)
    {
        // Download and instantiate the 3D model
        using (UnityWebRequest webRequest = UnityWebRequest.Get(modelUrl))
        {
            yield return webRequest.SendWebRequest();
            
            if (webRequest.result == UnityWebRequest.Result.Success)
            {
                GameObject arModel = InstantiateModelFromData(webRequest.downloadHandler.data);
                
                // Position based on GPS and AR plane detection
                Vector3 worldPosition = GetWorldPositionFromGPS();
                arModel.transform.position = worldPosition;
                
                // Era-specific effects
                ApplyEraEffects(arModel, era);
            }
        }
    }
    
    private void ApplyEraEffects(GameObject model, string era)
    {
        switch (era)
        {
            case "medieval":
                model.AddComponent<MedievalAudioController>();
                AddParticleEffect("DustParticles", model.transform);
                break;
            case "renaissance":
                model.AddComponent<RenaissanceLightController>();
                AddParticleEffect("GoldSparkles", model.transform);
                break;
        }
    }
}
