export const preciseTransactionService = {
  async processTransaction(transactionData: {
    amount: number;
    currency: string;
    commissionRate: number; // e.g., 0.25 for 25%
    taxRate: number;
    userId: string;
  }) {
    const currencyConfig = await this.getCurrencyConfig(transactionData.currency);
    const precision = currencyConfig.precision;
    
    // Convert to base units
    const amountBaseUnits = PrecisionMath.toBaseUnits(transactionData.amount, precision);
    
    // Calculate percentages in basis points
    const commissionBps = Math.round(transactionData.commissionRate * 100);
    const taxBps = Math.round(transactionData.taxRate * 100);
    
    // Calculate amounts with precise rounding
    const commissionAmount = PrecisionMath.calculatePercentage(
      amountBaseUnits,
      commissionBps,
      precision,
      'HALF_EVEN'
    );
    
    const taxAmount = PrecisionMath.calculatePercentage(
      amountBaseUnits,
      taxBps,
      precision,
      'HALF_EVEN'
    );
    
    const netAmount = amountBaseUnits - commissionAmount - taxAmount;
    
    // Verify no money is created or destroyed
    const calculatedTotal = netAmount + commissionAmount + taxAmount;
    const discrepancy = amountBaseUnits - calculatedTotal;
    
    if (discrepancy !== 0n) {
      await this.handleRoundingDiscrepancy(discrepancy, currencyConfig);
    }
    
    // Store transaction
    const transaction = await db.financial_transactions.create({
      data: {
        amount_base_units: amountBaseUnits,
        currency: transactionData.currency,
        currency_precision: precision,
        commission_rate_bps: commissionBps,
        tax_rate_bps: taxBps,
        commission_amount_base_units: commissionAmount,
        net_amount_base_units: netAmount
      }
    });
    
    return {
      transaction,
      amounts: {
        gross: PrecisionMath.fromBaseUnits(amountBaseUnits, precision),
        commission: PrecisionMath.fromBaseUnits(commissionAmount, precision),
        tax: PrecisionMath.fromBaseUnits(taxAmount, precision),
        net: PrecisionMath.fromBaseUnits(netAmount, precision)
      }
    };
  },

  async handleRoundingDiscrepancy(discrepancy: bigint, currencyConfig: any) {
    // Log rounding discrepancy for audit
    await db.rounding_discrepancies.create({
      data: {
        amount_base_units: discrepancy,
        currency: currencyConfig.code,
        resolved: false,
        created_at: new Date()
      }
    });
    
    // For small discrepancies, accumulate in a rounding account
    if (Math.abs(Number(discrepancy)) <= Math.pow(10, -currencyConfig.precision)) {
      await this.updateRoundingAccount(discrepancy, currencyConfig);
    } else {
      throw new Error(`Significant rounding discrepancy detected: ${discrepancy}`);
    }
  },

  async batchSettleRoundingDifferences() {
    // Periodically settle rounding accounts
    const discrepancies = await db.rounding_discrepancies.findMany({
      where: { resolved: false }
    });
    
    for (const discrepancy of discrepancies) {
      // Distribute rounding differences fairly
      await this.distributeRoundingDifference(discrepancy);
    }
  }
