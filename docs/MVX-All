// MAST-PWA Enhanced Service Worker
const MAST_CACHE_VERSION = 'v2.0';
const CACHE_NAME = `mast-pwa-${MAST_CACHE_VERSION}`;

// Advanced Caching Strategy - Network First, then Cache
const MAST_CACHE_URLS = [
  '/',
  '/styles/main.css',
  '/scripts/app.js',
  '/images/logo.svg',
  '/offline.html'
];

// Install Event - Precache Critical Resources
self.addEventListener('install', (event) => {
  console.log('MAST-PWA: Installing Service Worker');
  event.waitUntil(
    caches.open(CACHE_NAME)
      .then((cache) => {
        return cache.addAll(MAST_CACHE_URLS);
      })
      .then(() => {
        return self.skipWaiting();
      })
  );
});

// Advanced Fetch Handler - Smart Caching
self.addEventListener('fetch', (event) => {
  event.respondWith(
    // Network First Strategy for Dynamic Content
    fetch(event.request)
      .then((response) => {
        // Cache successful responses
        if (response.status === 200) {
          const responseClone = response.clone();
          caches.open(CACHE_NAME).then((cache) => {
            cache.put(event.request, responseClone);
          });
        }
        return response;
      })
      .catch(() => {
        // Fallback to Cache when offline
        return caches.match(event.request)
          .then((response) => {
            if (response) {
              return response;
            }
            // Return offline page for navigation requests
            if (event.request.mode === 'navigate') {
              return caches.match('/offline.html');
            }
          });
      })
  );
});

// MAST-PWA Background Sync for Form Submissions
self.addEventListener('sync', (event) => {
  if (event.tag === 'background-form-sync') {
    event.waitUntil(doBackgroundSync());
  }
});

async function doBackgroundSync() {
  // Sync form submissions when connection restores
  const requests = await getPendingSubmissions();
  for (const request of requests) {
    try {
      await fetch(request.url, request.options);
      await removePendingSubmission(request.id);
    } catch (error) {
      console.log('MAST-PWA: Background sync failed', error);
    }
  }
}
