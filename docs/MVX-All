    -- Immersive Experience Data
    vr_environment_url VARCHAR(500),
    ar_experience_url VARCHAR(500),
    photogrammetry_data JSONB, -- 3D scan data
    soundscape_data JSONB, -- Ambient sounds
    weather_simulation JSONB, -- Real-time weather replication
    
    -- Accessibility Features
    accessibility_features JSONB DEFAULT '{
        "wheelchair_accessible": true,
        "audio_descriptions": true,
        "haptic_feedback": true,
        "simplified_navigation": true,
        "contrast_options": true,
        "motion_reduction": true
