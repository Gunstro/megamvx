// supabase/functions/process-discovery/index.ts
import { serve } from 'https://deno.land/std@0.177.0/http/server.ts'
import { createClient } from 'https://esm.sh/@supabase/supabase-js@2'

const corsHeaders = {
  'Access-Control-Allow-Origin': '*',
  'Access-Control-Allow-Headers': 'authorization, x-client-info, apikey, content-type',
}

serve(async (req) => {
  if (req.method === 'OPTIONS') {
    return new Response('ok', { headers: corsHeaders })
  }

  try {
    const { discovery_id } = await req.json()
    
    const supabaseClient = createClient(
      Deno.env.get('SUPABASE_URL') ?? '',
      Deno.env.get('SUPABASE_SERVICE_ROLE_KEY') ?? ''
    )

    // Get discovery details
    const { data: discovery, error } = await supabaseClient
      .from('discoveries')
      .select(`
        *,
        cammino_locations:location_id(commission)
      `)
      .eq('id', discovery_id)
      .single()

    if (error) throw error

    // Award commission to user
    const { error: walletError } = await supabaseClient
      .from('user_wallets')
      .update({ balance: supabase.sql`balance + ${discovery.cammino_locations.commission}` })
      .eq('user_id', discovery.user_id)

    if (walletError) throw walletError

    return new Response(
      JSON.stringify({ success: true, commission: discovery.cammino_locations.commission }),
      { headers: { ...corsHeaders, 'Content-Type': 'application/json' } }
    )
  } catch (error) {
    return new Response(
      JSON.stringify({ error: error.message }),
      { status: 400, headers: { ...corsHeaders, 'Content-Type': 'application/json' } }
    )
  }
})
