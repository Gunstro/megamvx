// lib/megaconnect-service.ts
export const megaConnectService = {
  async updateUserLocation(userId: string, locationData: any) {
    const location = await db.user_locations.upsert({
      where: { user_id: userId },
      update: {
        latitude: locationData.latitude,
        longitude: locationData.longitude,
        accuracy: locationData.accuracy,
        altitude: locationData.altitude,
        location_type: locationData.location_type,
        activity_context: locationData.activity_context,
        updated_at: new Date()
      },
      create: {
        user_id: userId,
        ...locationData
      }
    })

    // Check for proximity matches
    const matches = await this.findProximityMatches(userId, locationData)
    
    // Check for brand zones
    const brandZones = await this.findNearbyBrandZones(locationData)

    return {
      location,
      matches: matches.slice(0, 10), // Limit to 10 closest matches
      brandZones,
      recommendations: await this.generateProximityRecommendations(userId, locationData)
    }
  },

  async findProximityMatches(userId: string, userLocation: any) {
    const proximityRadius = 500 // meters
    const currentUser = await db.users.findFirst({
      where: { id: userId },
      include: {
        profile: true,
        advertising_profile: true
      }
    })

    // Find nearby users
    const nearbyUsers = await db.user_locations.findMany({
      where: {
        user_id: { not: userId },
        location_sharing_enabled: true,
        AND: [
          {
            latitude: {
              gte: userLocation.latitude - (proximityRadius / 111320), // Approx meters to degrees
              lte: userLocation.latitude + (proximityRadius / 111320)
            }
          },
          {
            longitude: {
              gte: userLocation.longitude - (proximityRadius / (111320 * Math.cos(userLocation.latitude * Math.PI / 180))),
              lte: userLocation.longitude + (proximityRadius / (111320 * Math.cos(userLocation.latitude * Math.PI / 180)))
            }
          }
        ]
      },
      include: {
        user: {
          include: {
            profile: true,
            advertising_profile: true
          }
        }
      }
    })

    // Calculate match scores
    const scoredMatches = nearbyUsers.map(nearbyUser => {
      const distance = this.calculateDistance(
        userLocation.latitude,
        userLocation.longitude,
        nearbyUser.latitude,
        nearbyUser.longitude
      )

      const matchScore = this.calculateMatchScore(currentUser, nearbyUser.user, distance)

      return {
        user: nearbyUser.user,
        distance: Math.round(distance),
        matchScore: Math.round(matchScore),
        commonInterests: this.findCommonInterests(currentUser, nearbyUser.user),
        availableGames: this.getAvailableGamesForPair(currentUser, nearbyUser.user)
      }
    })

    return scoredMatches
      .filter(match => match.distance <= proximityRadius)
      .sort((a, b) => b.matchScore - a.matchScore)
  },

  async createProximityEncounter(userId: string, targetUserId: string, encounterData: any) {
    const encounter = await db.proximity_encounters.create({
      data: {
        user_a_id: userId,
        user_b_id: targetUserId,
        initiated_by: userId,
        ...encounterData
      }
    })

    // Send real-time notification to target user
    await realTimeService.sendProximityNotification(targetUserId, {
      type: 'proximity_encounter',
      fromUserId: userId,
      encounterId: encounter.id,
      location: encounterData.location,
      suggestedGames: encounterData.availableGames
    })

    return encounter
  },

  async startProximityGame(userId: string, gameId: string, playerIds: string[]) {
    const game = await db.proximity_games.findFirst({
      where: { id: gameId }
    })

    if (!game) {
      throw new Error('Game not found')
    }

    // Verify all players are nearby
    const playersNearby = await this.verifyPlayersProximity(playerIds)
    if (!playersNearby) {
      throw new Error('Players are not in proximity')
    }

    // Generate session code
    const sessionCode = this.generateSessionCode()

    const gameSession = await db.proximity_game_sessions.create({
      data: {
        game_id: gameId,
        session_code: sessionCode,
        host_user_id: userId,
        player_ids: playerIds,
        session_status: 'waiting',
        time_limit: new Date(Date.now() + (game.duration_minutes * 60 * 1000))
      }
    })

    // Notify all players
    await Promise.all(
      playerIds.map(playerId =>
        realTimeService.sendGameInvitation(playerId, {
          sessionId: gameSession.id,
          sessionCode,
          game: game,
          host: await db.users.findFirst({ where: { id: userId } })
        })
      )
    )

    return {
      session: gameSession,
      joinCode: sessionCode,
      gameDetails: game
    }
  },

  async joinProximityGame(sessionCode: string, userId: string) {
    const gameSession = await db.proximity_game_sessions.findFirst({
      where: { session_code: sessionCode },
      include: { game: true }
    })

    if (!gameSession) {
      throw new Error('Game session not found')
    }

    if (gameSession.session_status !== 'waiting') {
      throw new Error('Game session is no longer accepting players')
    }

    // Verify player proximity
    const isNearby = await this.verifyPlayerProximity(userId, gameSession)
    if (!isNearby) {
      throw new Error('You are not in the game area')
    }

    // Add player to session
    const updatedSession = await db.proximity_game_sessions.update({
      where: { id: gameSession.id },
      data: {
        player_ids: { push: userId }
      }
    })

    // Notify other players
    await realTimeService.broadcastToSession(gameSession.id, 'player_joined', {
      userId,
      playerCount: updatedSession.player_ids.length
    })

    return updatedSession
  },

  async completeProximityGame(sessionId: string, results: any) {
    const gameSession = await db.proximity_game_sessions.findFirst({
      where: { id: sessionId },
      include: { game: true }
    })

    if (!gameSession) {
      throw new Error('Game session not found')
    }

    // Calculate rewards
    const rewards = this.calculateGameRewards(gameSession, results)

    // Distribute rewards
    await Promise.all(
      Object.entries(rewards.playerRewards).map(async ([playerId, reward]) => {
        await gamifiedAdsService.awardUserRewards(playerId, reward, `Proximity game: ${gameSession.game.title}`)
      })
    )

    // Update brand engagement metrics
    if (gameSession.game.brand_sponsor_id) {
      await this.recordBrandEngagement(
        gameSession.game.brand_sponsor_id,
        gameSession.player_ids,
        'proximity_game',
        {
          sessionId: gameSession.id,
          results,
          totalRewards: rewards.totalRewards
        }
      )
    }

    // Update session
    const updatedSession = await db.proximity_game_sessions.update({
      where: { id: sessionId },
      data: {
        session_status: 'completed',
        completed_at: new Date(),
        final_scores: results.scores,
        rewards_distributed: rewards.playerRewards
      }
    })

    // Create social connections between players
    await this.createSocialConnections(gameSession.player_ids, {
      connection_type: 'game',
      met_through_game: sessionId
    })

    return {
      session: updatedSession,
      rewards,
      connections: await this.getNewConnections(gameSession.player_ids)
    }
  },

  async findNearbyBrandZones(location: any) {
    const brandZones = await db.brand_proximity_zones.findMany({
      where: {
        is_active: true,
        // Check if current time is within active hours
        OR: [
          { active_start: null, active_end: null },
          {
            AND: [
              { active_start: { lte: new Date().toTimeString() } },
              { active_end: { gte: new Date().toTimeString() } }
            ]
          }
        ]
      },
      include: {
        brand: {
          include: {
            business: true
          }
        }
      }
    })

    return brandZones
      .map(zone => {
        const distance = this.calculateDistance(
          location.latitude,
          location.longitude,
          zone.zone_center_lat,
          zone.zone_center_lng
        )

        return {
          ...zone,
          distance: Math.round(distance),
          is_in_zone: distance <= zone.zone_radius_meters,
          available_rewards: this.calculateZoneRewards(zone, distance)
        }
      })
      .filter(zone => zone.distance <= 1000) // Within 1km
      .sort((a, b) => a.distance - b.distance)
  },

  async createBrandProximityZone(brandId: string, zoneData: any) {
    const zone = await db.brand_proximity_zones.create({
      data: {
        brand_id: brandId,
        ...zoneData
      }
    })

    // Set up real-time geofencing
    await realTimeService.setupGeofence(zone.id, {
      center: [zone.zone_center_lat, zone.zone_center_lng],
      radius: zone.zone_radius_meters
    })

    return zone
  },

  async handleUserEnteringBrandZone(userId: string, zoneId: string) {
    const zone = await db.brand_proximity_zones.findFirst({
      where: { id: zoneId },
      include: { brand: true }
    })

    // Send welcome notification with game offers
    await notificationService.sendBrandZoneWelcome(userId, zone)

    // Check for nearby users to start group games
    const nearbyUsers = await this.findProximityMatches(userId, await this.getUserLocation(userId))
    const potentialPlayers = nearbyUsers
      .filter(match => match.distance <= 50) // Very close - within 50m
      .slice(0, zone.max_concurrent_players - 1)

    if (potentialPlayers.length >= zone.min_players) {
      await this.suggestBrandGame(userId, zone, potentialPlayers)
    }

    return {
      zone,
      welcomeBonus: this.calculateWelcomeBonus(zone),
      nearbyPlayers: potentialPlayers.length
    }
  }
}
