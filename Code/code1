Table 10: audit_log - System Audit Trail
sql
CREATE TABLE audit_log (
    -- Primary Identifier
    id BIGSERIAL PRIMARY KEY,
    
    -- Audit Information
    event_type VARCHAR(100) NOT NULL,
    event_subtype VARCHAR(100),
    
    -- Entity Reference
    entity_type VARCHAR(50) NOT NULL,
    entity_id UUID NOT NULL,
    
    -- User Context
    performed_by_user_id UUID REFERENCES users(id),
    performed_by_system BOOLEAN DEFAULT FALSE,
    
    -- Change Details
    old_values JSONB,
    new_values JSONB,
    changes JSONB GENERATED ALWAYS AS (
        CASE 
            WHEN old_values IS NOT NULL AND new_values IS NOT NULL THEN
                (SELECT jsonb_object_agg(key, value)
                 FROM jsonb_each(new_values)
                 WHERE (old_values -> key) IS DISTINCT FROM value)
            ELSE NULL
        END
    ) STORED,
    
    -- Request Context
    ip_address INET,
    user_agent TEXT,
    request_id UUID,
    
    -- System Fields
    created_at TIMESTAMPTZ DEFAULT NOW(),
    
    -- Constraints
    CHECK (performed_by_user_id IS NOT NULL OR performed_by_system = TRUE)
);

-- Indexes (Optimized for Investigation)
CREATE INDEX idx_audit_entity ON audit_log(entity_type, entity_id, created_at);
CREATE INDEX idx_audit_user ON audit_log(performed_by_user_id, created_at);
CREATE INDEX idx_audit_event ON audit_log(event_type, created_at);
CREATE INDEX idx_audit_date ON audit_log(DATE(created_at));
CREATE INDEX idx_audit_request ON audit_log(request_id) WHERE request_id IS NOT NULL;

