// lib/advertising-service.ts
export const advertisingService = {
  async createAdCampaign(advertiserId: string, campaignData: any) {
    const campaign = await db.magazine_advertisements.create({
      data: {
        advertiser_id: advertiserId,
        status: 'pending',
        ...campaignData
      }
    })

    // Process payment if immediate activation
    if (campaignData.activate_immediately) {
      const paymentResult = await this.processAdPayment(
        advertiserId,
        campaignData.total_budget,
        'ad_campaign'
      )

      if (paymentResult.success) {
        await db.magazine_advertisements.update({
          where: { id: campaign.id },
          data: { status: 'active' }
        })
      }
    }

    return campaign
  },

  async getAvailableAdPlacements(issueId: string, filters: any = {}) {
    const placements = await db.ad_placement_zones.findMany({
      where: { 
        is_active: true,
        ...(filters.zone_type && { zone_name: { contains: filters.zone_type } })
      }
    })

    // Check availability for specific issue
    const placementsWithAvailability = await Promise.all(
      placements.map(async (placement) => {
        const currentAds = await db.magazine_advertisements.count({
          where: {
            issue_id: issueId,
            placement_type: placement.zone_name,
            status: 'active'
          }
        })

        return {
          ...placement,
          available_slots: placement.max_ads_per_issue - currentAds,
          is_available: currentAds < placement.max_ads_per_issue
        }
      })
    )

    return placementsWithAvailability.filter(p => p.is_available)
  },

  async serveAd(userId: string, context: any) {
    const {
      issueId,
      pageType,
      userInterests,
      geographicLocation,
      browsingHistory
    } = context

    // Get targeted ads
    const targetedAds = await db.magazine_advertisements.findMany({
      where: {
        status: 'active',
        OR: [
          { issue_id: issueId },
          { issue_id: null } // Run-of-publication ads
        ],
        scheduled_start: { lte: new Date() },
        scheduled_end: { gte: new Date() }
      },
      include: {
        advertiser: {
          include: {
            business: true
          }
        }
      }
    })

    // Score and rank ads based on relevance
    const scoredAds = targetedAds.map(ad => ({
      ad,
      relevanceScore: this.calculateAdRelevance(ad, {
        userInterests,
        geographicLocation,
        browsingHistory,
        pageType
      })
    }))

    // Filter by budget and select top ads
    const availableAds = scoredAds
      .filter(({ ad }) => this.isWithinBudget(ad))
      .sort((a, b) => b.relevanceScore - a.relevanceScore)
      .slice(0, 3) // Return top 3 ads

    // Record impressions
    await Promise.all(
      availableAds.map(({ ad }) => 
        this.recordImpression(ad.id, userId)
      )
    )

    return availableAds.map(({ ad }) => this.formatAdForDisplay(ad))
  },

  async createSponsoredArticle(advertiserId: string, articleData: any) {
    // Create the article first
    const article = await db.magazine_articles.create({
      data: {
        ...articleData.article,
        is_published: false
      }
    })

    // Create sponsorship record
    const sponsorship = await db.sponsored_articles.create({
      data: {
        advertiser_id: advertiserId,
        article_id: article.id,
        sponsorship_type: articleData.sponsorship_type,
        sponsorship_fee: articleData.sponsorship_fee,
        disclosure_text: articleData.disclosure_text || 'Sponsored Content'
      }
    })

    // Process payment
    const paymentResult = await this.processAdPayment(
      advertiserId,
      articleData.sponsorship_fee,
      'sponsored_content'
    )

    if (paymentResult.success) {
      // Publish the article
      await db.magazine_articles.update({
        where: { id: article.id },
        data: { 
          is_published: true,
          published_at: new Date()
        }
      })

      await db.sponsored_articles.update({
        where: { id: sponsorship.id },
        data: { payment_status: 'paid' }
      })
    }

    return { article, sponsorship }
  },

  async boostClassifiedListing(listingId: string, boostOptions: any) {
    const listing = await db.classified_listings.findFirst({
      where: { id: listingId }
    })

    if (!listing) {
      throw new Error('Classified listing not found')
    }

    const boostCost = this.calculateBoostCost(boostOptions)

    const paymentResult = await this.processAdPayment(
      listing.lister_id,
      boostCost,
      'classified_boost'
    )

    if (!paymentResult.success) {
      throw new Error('Boost payment failed')
    }

    const boostExpiry = new Date()
    boostExpiry.setDate(boostExpiry.getDate() + (boostOptions.duration_days || 7))

    const updatedListing = await db.classified_listings.update({
      where: { id: listingId },
      data: {
        is_boosted: true,
        boost_expires_at: boostExpiry
      }
    })

    return updatedListing
  },

  async calculateBoostCost(boostOptions: any): Promise<number> {
    let cost = 50 // Base cost

    // Duration multiplier
    if (boostOptions.duration_days > 7) cost *= 1.5
    if (boostOptions.duration_days > 30) cost *= 2

    // Category multiplier
    const categoryMultipliers = {
      'supercars': 2.0,
      'luxury_homes': 1.8,
      'yachts': 2.2,
      'private_jets': 3.0,
      'helicopters': 2.5
    }

    cost *= (categoryMultipliers[boostOptions.category] || 1.0)

    return cost
  },

  async recordAdConversion(adId: string, userId: string, conversionType: string) {
    await db.ad_analytics.create({
      data: {
        ad_id: adId,
        date: new Date(),
        conversions: 1
      }
    })

    await db.magazine_advertisements.update({
      where: { id: adId },
      data: {
        conversions: { increment: 1 }
      }
    })

    // Award commission if applicable
    await this.awardAffiliateCommission(adId, userId, conversionType)
  },

  async getAdvertiserDashboard(advertiserId: string) {
    const [
      activeCampaigns,
      performanceMetrics,
      recentConversions,
      spending
    ] = await Promise.all([
      db.magazine_advertisements.findMany({
        where: { advertiser_id: advertiserId, status: 'active' }
      }),
      db.ad_analytics.groupBy({
        by: ['ad_id'],
        where: {
          ad: { advertiser_id: advertiserId }
        },
        _sum: {
          impressions: true,
          clicks: true,
          conversions: true,
          revenue: true
        }
      }),
      db.ad_analytics.findMany({
        where: {
          ad: { advertiser_id: advertiserId },
          conversions: { gt: 0 }
        },
        orderBy: { created_at: 'desc' },
        take: 10
      }),
      this.calculateAdSpending(advertiserId)
    ])

    return {
      activeCampaigns,
      performanceMetrics,
      recentConversions,
      spending,
      recommendations: this.generateOptimizationRecommendations(activeCampaigns)
    }
  }
}
