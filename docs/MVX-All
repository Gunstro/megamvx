class BluetoothHarvester {
  constructor() {
    this.scanningActive = false;
    this.discoveredDevices = new Map();
    this.commissionEngine = new CommissionCalculator();
  }

  async startHarvesting() {
    if (!navigator.bluetooth) {
      throw new Error('Bluetooth not supported');
    }

    this.scanningActive = true;
    
    const scanner = await navigator.bluetooth.requestLEScan({
      acceptAllAdvertisements: true,
      keepRepeatedDevices: true
    });

    navigator.bluetooth.addEventListener('advertisementreceived', (event) => {
      this.processDeviceDiscovery(event);
    });
  }

  processDeviceDiscovery(event) {
    const deviceData = {
      uuid: event.device.id,
      rssi: event.rssi,
      txPower: event.txPower,
      manufacturerData: event.manufacturerData,
      serviceData: event.serviceData,
      timestamp: Date.now()
    };

    // Get precise location
    this.getGeolocation().then(location => {
      this.submitDeviceClaim(deviceData, location);
    });
  }

  async submitDeviceClaim(deviceData, location) {
    // Check if device already claimed
    const existing = await this.checkExistingClaim(deviceData.uuid);
    
    if (!existing) {
      // First discovery - user can claim
      this.promptUserClaim(deviceData, location);
    } else {
      // Existing claim - ping for commission
      this.recordDevicePing(deviceData, location);
    }
  }
}
