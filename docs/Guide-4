// lib/business-service.ts
import { geographicWalletService } from './geographic-wallet-service'

export const businessService = {
  async createBusinessListing(data: {
    userId: string
    territoryId: string
    businessName: string
    slogan?: string
    description: string
    category: string
    phone: string
    email: string
    address: string
  }) {
    // Generate subdomain
    const subdomain = data.businessName
      .toLowerCase()
      .replace(/[^a-z0-9]/g, '-')
      .replace(/-+/g, '-')
      .substring(0, 63)

    // Create listing
    const listing = await db.business_listings.create({
      data: {
        ...data,
        subdomain,
        is_active: false // Wait for payment
      }
    })

    return listing
  },

  async purchaseAdvertisingBlock(businessId: string, blockNumber: number, userId: string) {
    const pricing = { 1: 5.00, 2: 1.00, 3: 1.00, 4: 1.00, 5: 1.00, 6: 1.00 }
    const monthlyFee = pricing[blockNumber as keyof typeof pricing]

    // Get business and territory info
    const business = await db.business_listings.findFirst({
      where: { id: businessId },
      include: { territory: true }
    })

    if (!business) throw new Error('Business not found')

    // Process payment through geographic wallet
    const paymentResult = await geographicWalletService.processBusinessPayment(
      userId,
      business.territory_id,
      monthlyFee,
      'GBP',
      'advertising_block'
    )

    if (!paymentResult.success) {
      throw new Error(`Payment failed: ${paymentResult.error}`)
    }

    // Create/update advertising block
    const expiresAt = new Date()
    expiresAt.setMonth(expiresAt.getMonth() + 1)

    const block = await db.advertising_blocks.upsert({
      where: {
        business_id_block_number: {
          business_id: businessId,
          block_number: blockNumber
        }
      },
      update: {
        is_active: true,
        expires_at: expiresAt,
        monthly_fee: monthlyFee
      },
      create: {
        business_id: businessId,
        block_number: blockNumber,
        is_active: true,
        expires_at: expiresAt,
        monthly_fee: monthlyFee
      }
    })

    // Record transaction
    await db.business_transactions.create({
      data: {
        business_id: businessId,
        user_id: userId,
        transaction_type: 'block_purchase',
        amount: monthlyFee,
        hedera_transaction_id: paymentResult.transactionId
      }
    })

    // Activate business if this is the first block
    if (!business.is_active) {
      await db.business_listings.update({
        where: { id: businessId },
        data: { is_active: true }
      })
    }

    return {
      block,
      transaction: paymentResult,
      message: `Successfully purchased Block ${blockNumber} for £${monthlyFee}/month`
    }
  },

  async getActiveBlocksByTerritory(territoryId: string) {
    return await db.advertising_blocks.findMany({
      where: {
        is_active: true,
        business: {
          territory_id: territoryId,
          is_verified: true
        }
      },
      include: {
        business: {
          select: {
            business_name: true,
            slogan: true,
            category: true,
            subdomain: true
          }
        }
      },
      orderBy: [
        { block_number: 'asc' },
        { purchased_at: 'desc' }
      ]
    })
  }
}
