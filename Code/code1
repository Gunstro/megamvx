1.4 Views for Reporting
View 1: user_matrix_view - Complete User Matrix View
sql
CREATE OR REPLACE VIEW user_matrix_view AS
SELECT 
    u.id as user_id,
    u.first_name,
    u.last_name,
    u.email,
    u.kyc_status,
    
    mp.matrix_level,
    mp.sponsor_id,
    s.first_name as sponsor_first_name,
    s.last_name as sponsor_last_name,
    mp.level_position_number,
    mp.max_downline_capacity,
    mp.current_downline_count,
    mp.is_orphan,
    
    vt.name as current_visa_tier,
    vt.once_off_price_gbp,
    vt.monthly_fee_gbp,
    vt.monthly_cap_gbp,
    
    uf.wallet_balance_gbp,
    uf.current_month_earnings_gbp,
    uf.next_fee_due_date,
    uf.fee_trigger_met_current_month,
    
    mp.created_at as matrix_join_date,
    uf.last_financial_update
    
FROM users u
JOIN matrix_positions mp ON mp.user_id = u.id
LEFT JOIN users s ON s.id = mp.sponsor_id
JOIN user_financials uf ON uf.user_id = u.id
JOIN visa_tiers vt ON vt.id = uf.current_visa_tier_id
WHERE mp.is_active = TRUE
ORDER BY mp.matrix_level, mp.level_position_number NULLS LAST;
View 2: commission_summary_daily - Daily Commission Reporting
sql
CREATE OR REPLACE VIEW commission_summary_daily AS
SELECT 
    DATE(ce.created_at) as report_date,
    COUNT(DISTINCT ce.id) as total_transactions,
    COUNT(DISTINCT ce.purchaser_user_id) as unique_purchasers,
    SUM(ce.purchase_amount_gbp) as total_purchase_volume_gbp,
    SUM(ce.matrix_commission_pool_gbp) as total_commission_pool_gbp,
    
    COUNT(DISTINCT cd.receiver_user_id) as unique_commission_receivers,
    SUM(cd.paid_amount_gbp) as total_commissions_paid_gbp,
    SUM(cd.surplus_amount_gbp) as total_surplus_to_poverty_fund_gbp,
    
    -- Average commission per receiver
    ROUND(AVG(cd.paid_amount_gbp), 2) as avg_commission_per_receiver_gbp,
    
    -- Success rate
    ROUND(
        COUNT(DISTINCT CASE WHEN cd.status = 'paid' THEN cd.id END) * 100.0 / 
        COUNT(DISTINCT cd.id), 
        2
    ) as payment_success_rate_percent
    
FROM commission_events ce
LEFT JOIN commission_distributions cd ON cd.commission_event_id = ce.id
WHERE ce.status = 'completed'
GROUP BY DATE(ce.created_at)
ORDER BY DATE(ce.created_at) DESC;
View 3: user_earnings_dashboard - User Earnings Summary
sql
CREATE OR REPLACE VIEW user_earnings_dashboard AS
SELECT 
    u.id as user_id,
    u.first_name,
    u.last_name,
    u.email,
    
    vt.name as current_visa_tier,
    vt.monthly_cap_gbp,
    
    uf.wallet_balance_gbp as available_balance_gbp,
    uf.pending_balance_gbp as pending_balance_gbp,
    uf.current_month_earnings_gbp,
    uf.total_earned_gbp as lifetime_earnings_gbp,
    
    -- Monthly fee status
    CASE 
        WHEN uf.next_fee_due_date <= CURRENT_DATE THEN 'Overdue'
        WHEN uf.next_fee_due_date <= CURRENT_DATE + INTERVAL '7 days' THEN 'Due Soon'
        ELSE 'Paid Up'
    END as fee_status,
    
    uf.next_fee_due_date,
    
    -- Upgrade eligibility
    CASE 
        WHEN uf.wallet_balance_gbp >= next_tier.once_off_price_gbp THEN 'Eligible'
        ELSE 'Not Eligible'
    END as upgrade_eligibility,
    
    COALESCE(next_tier.name, 'MAX TIER') as next_tier_name,
    COALESCE(next_tier.once_off_price_gbp, 0) as next_tier_price_gbp,
    
    -- Days until cap reached (estimate)
    CASE 
        WHEN uf.current_month_earnings_gbp > 0 THEN
            FLOOR((vt.monthly_cap_gbp - uf.current_month_earnings_gbp) / 
                  (uf.current_month_earnings_gbp / EXTRACT(DAY FROM CURRENT_DATE)))
        ELSE NULL
    END as estimated_days_until_cap,
    
    -- Risk of surplus loss
    CASE 
        WHEN uf.wallet_balance_gbp >= vt.monthly_cap_gbp * 0.9 THEN 'High Risk'
        WHEN uf.wallet_balance_gbp >= vt.monthly_cap_gbp * 0.7 THEN 'Medium Risk'
        ELSE 'Low Risk'
    END as surplus_risk_level
    
FROM users u
JOIN user_financials uf ON uf.user_id = u.id
JOIN visa_tiers vt ON vt.id = uf.current_visa_tier_id
LEFT JOIN visa_tiers next_tier ON next_tier.tier_order = vt.tier_order + 1
WHERE u.is_active = TRUE
ORDER BY uf.current_month_earnings_gbp DESC;
1.5 Functions
Function 1: get_upline_chain - Calculate Upline for Commissions
sql
CREATE OR REPLACE FUNCTION get_upline_chain(
    p_user_id UUID,
    p_max_levels INTEGER DEFAULT 5
)
RETURNS TABLE (
    ancestor_user_id UUID,
    level_distance INTEGER,
    ancestor_matrix_level INTEGER
) AS $$
DECLARE
    current_user_id UUID := p_user_id;
    current_level_distance INTEGER := 1;
    current_sponsor_id UUID;
BEGIN
    WHILE current_level_distance <= p_max_levels LOOP
        -- Get immediate sponsor
        SELECT sponsor_id INTO current_sponsor_id
        FROM matrix_positions
        WHERE user_id = current_user_id
          AND is_active = TRUE;
        
        -- If no sponsor, break
        EXIT WHEN current_sponsor_id IS NULL;
        
        -- Get sponsor's matrix level
        SELECT matrix_level INTO ancestor_matrix_level
        FROM matrix_positions
        WHERE user_id = current_sponsor_id
          AND is_active = TRUE;
        
        -- Return this ancestor
        ancestor_user_id := current_sponsor_id;
        level_distance := current_level_distance;
        RETURN NEXT;
        
        -- Move up the chain
        current_user_id := current_sponsor_id;
        current_level_distance := current_level_distance + 1;
    END LOOP;
END;
$$ LANGUAGE plpgsql;
Function 2: calculate_commission_distribution - Core Commission Logic
sql
CREATE OR REPLACE FUNCTION calculate_commission_distribution(
    p_commission_event_id UUID
)
RETURNS TABLE (
    receiver_user_id UUID,
    level_distance INTEGER,
    commission_rate DECIMAL(5,4),
    calculated_amount_gbp DECIMAL(10,2),
    cap_to_apply_gbp DECIMAL(10,2)
) AS $$
DECLARE
    v_commission_event RECORD;
    v_upline_record RECORD;
    v_receiver_financials RECORD;
    v_commission_amount DECIMAL(10,2);
    v_available_cap_gbp DECIMAL(10,2);
BEGIN
    -- Get commission event details
    SELECT * INTO v_commission_event
    FROM commission_events
    WHERE id = p_commission_event_id;
    
    -- Calculate for each upline member
    FOR v_upline_record IN 
        SELECT * FROM get_upline_chain(v_commission_event.purchaser_user_id, 5)
    LOOP
        -- Get commission rate for this level distance
        SELECT commission_rate INTO commission_rate
        FROM commission_rates
        WHERE level_distance = v_upline_record.level_distance
          AND is_active = TRUE;
        
        -- Calculate commission amount
        v_commission_amount := v_commission_event.matrix_commission_pool_gbp * commission_rate;
        
        -- Get receiver's current financial status
        SELECT * INTO v_receiver_financials
        FROM user_financials uf
        JOIN visa_tiers vt ON vt.id = uf.current_visa_tier_id
        WHERE uf.user_id = v_upline_record.ancestor_user_id;
        
        -- Calculate available cap
        v_available_cap_gbp := GREATEST(
            0, 
            v_receiver_financials.monthly_cap_gbp - v_receiver_financials.current_month_earnings_gbp
        );
        
        -- Return results
        receiver_user_id := v_upline_record.ancestor_user_id;
        level_distance := v_upline_record.level_distance;
        calculated_amount_gbp := v_commission_amount;
        cap_to_apply_gbp := LEAST(v_commission_amount, v_available_cap_gbp);
        
        RETURN NEXT;
    END LOOP;
END;
$$ LANGUAGE plpgsql;
1.6 Triggers
Trigger 1: update_matrix_position_audit - Audit Matrix Changes
sql
CREATE OR REPLACE FUNCTION log_matrix_position_change()
RETURNS TRIGGER AS $$
BEGIN
    INSERT INTO audit_log (
        event_type,
        entity_type,
        entity_id,
        performed_by_user_id,
        performed_by_system,
        old_values,
        new_values
    ) VALUES (
        CASE 
            WHEN TG_OP = 'INSERT' THEN 'matrix_position.created'
            WHEN TG_OP = 'UPDATE' THEN 'matrix_position.updated'
            WHEN TG_OP = 'DELETE' THEN 'matrix_position.deleted'
        END,
        'matrix_position',
        COALESCE(NEW.id, OLD.id),
        CURRENT_USER_ID(), -- This would need to be set from application
        FALSE,
        CASE WHEN TG_OP IN ('UPDATE', 'DELETE') THEN row_to_json(OLD) END,
        CASE WHEN TG_OP IN ('INSERT', 'UPDATE') THEN row_to_json(NEW) END
    );
    
    RETURN COALESCE(NEW, OLD);
END;
$$ LANGUAGE plpgsql;

CREATE TRIGGER matrix_position_audit_trigger
AFTER INSERT OR UPDATE OR DELETE ON matrix_positions
FOR EACH ROW EXECUTE FUNCTION log_matrix_position_change();
Trigger 2: update_user_financials_timestamp - Auto-update timestamp
sql
CREATE OR REPLACE FUNCTION update_user_financials_timestamp()
RETURNS TRIGGER AS $$
BEGIN
    NEW.updated_at = NOW();
    NEW.last_financial_update = NOW();
    RETURN NEW;
END;
$$ LANGUAGE plpgsql;

CREATE TRIGGER user_financials_timestamp_trigger
BEFORE UPDATE ON user_financials
FOR EACH ROW EXECUTE FUNCTION update_user_financials_timestamp();
