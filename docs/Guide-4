// lib/subdomain-service.ts
import { DNS } from '@cloudflare/cloudflare'
import { generate } from 'random-words'

export const subdomainService = {
  async provisionBusinessWebsite(businessId: string, businessName: string) {
    try {
      // Generate unique subdomain
      const subdomain = await this.generateUniqueSubdomain(businessName)
      
      // Get default template
      const template = await this.getDefaultTemplate()
      
      // Create website record
      const website = await db.business_websites.create({
        data: {
          business_id: businessId,
          template_id: template.id,
          subdomain: subdomain,
          status: 'provisioning',
          meta_title: `${businessName} | MegatonCities Business`,
          meta_description: `Discover ${businessName} on MegatonCities - your trusted local business.`
        }
      })

      // Create default pages
      await this.createDefaultPages(website.id, businessName)

      // Configure DNS
      await this.configureDNS(subdomain)

      // Deploy template
      await this.deployTemplate(website, template)

      // Update status
      await db.business_websites.update({
        where: { id: website.id },
        data: { status: 'active' }
      })

      // Update business listing with subdomain
      await db.business_listings.update({
        where: { id: businessId },
        data: { subdomain: subdomain }
      })

      return {
        success: true,
        subdomain: subdomain,
        url: `https://${subdomain}.megatoncities.com`,
        websiteId: website.id
      }

    } catch (error) {
      console.error('Website provisioning failed:', error)
      await db.business_websites.updateMany({
        where: { business_id: businessId },
        data: { status: 'failed' }
      })
      throw new Error(`Website provisioning failed: ${error.message}`)
    }
  },

  async generateUniqueSubdomain(businessName: string): Promise<string> {
    const baseSlug = businessName
      .toLowerCase()
      .replace(/[^a-z0-9]/g, '-')
      .replace(/-+/g, '-')
      .substring(0, 30)

    let subdomain = baseSlug
    let counter = 1
    let isUnique = false

    while (!isUnique && counter < 10) {
      const existing = await db.business_websites.findFirst({
        where: { subdomain: subdomain }
      })

      if (!existing) {
        isUnique = true
      } else {
        // Add random words to ensure uniqueness
        const randomWord = generate({ exactly: 1, wordsPerString: 1 })[0]
        subdomain = `${baseSlug}-${randomWord}`
        counter++
      }
    }

    if (!isUnique) {
      // Final fallback - add timestamp
      const timestamp = Date.now().toString(36)
      subdomain = `${baseSlug}-${timestamp}`
    }

    return subdomain
  },

  async configureDNS(subdomain: string) {
    // Cloudflare API integration
    const cloudflare = new Cloudflare({
      apiEmail: process.env.CLOUDFLARE_EMAIL,
      apiKey: process.env.CLOUDFLARE_API_KEY
    })

    try {
      // Create CNAME record pointing to our main application
      await cloudflare.dns.records.create({
        zone_id: process.env.CLOUDFLARE_ZONE_ID!,
        type: 'CNAME',
        name: subdomain,
        content: 'app.megatoncities.com', // Your main application domain
        proxied: true, // Use Cloudflare proxy
        ttl: 1 // Automatic TTL
