  getNextAd(cvbLocation, userProfile, timeOfDay) {
    const availableCampaigns = this.getEligibleCampaigns(cvbLocation);
    
    // Weight campaigns based on multiple factors
    const weightedCampaigns = availableCampaigns.map(campaign => ({
      campaign,
      weight: this.calculateCampaignWeight(campaign, userProfile, timeOfDay)
    }));

    // Select campaign with highest weight
    return this.selectWeightedCampaign(weightedCampaigns);
  }

  calculateCampaignWeight(campaign, userProfile, timeOfDay) {
    let weight = 1.0;

    // Demographic matching
    weight *= this.calculateDemographicMatch(campaign.target_demographics, userProfile);
    
    // Time relevance
    weight *= this.calculateTimeRelevance(campaign.time_slots, timeOfDay);
    
    // Performance history
    weight *= this.calculatePerformanceMultiplier(campaign.engagement_rate);
    
    // Budget remaining (prioritize campaigns with budget)
    weight *= this.calculateBudgetMultiplier(campaign.budget_remaining);

    return weight;
  }
}
